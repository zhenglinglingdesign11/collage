{
  "name": "journal-collage",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "compile:first-release-catalog": "node scripts/compile-first-release-product-catalog.js",
    "compile:first-release-runtime-catalog": "node scripts/compile-first-release-product-catalog.js --runtime",
    "compile:template-recipes": "node scripts/compile-template-recipes.js",
    "validate:template-layer-inventory": "node scripts/validate-template-layer-inventory.js",
    "calibrate:template-layer": "node scripts/calibrate-template-layer-inventory.js"
  }
}
