.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  background: #fafaf8;
  color: #111111;
}

.title {
  font-size: 44rpx;
  font-weight: 650;
  line-height: 56rpx;
}

.section {
  margin-top: 34rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty {
  margin-top: 18rpx;
  padding: 32rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 16rpx;
  background: #ffffff;
  color: #6f6f6f;
  font-size: 26rpx;
}

.action {
  margin-top: 28rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 76rpx;
}
