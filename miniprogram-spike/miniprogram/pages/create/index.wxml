<view class="page">
  <scroll-view wx:if="{{isEmptyMode}}" scroll-y class="empty-content" style="padding-top: {{chromeTop}}px;">
    <view class="empty-header">
      <view class="page-title">新拼贴</view>
    </view>

    <view class="empty-workspace">
      <button class="starter-panel upload-zone" bindtap="choosePhoto">
        <view class="upload-content">
          <view class="round-action">+</view>
          <view class="primary-label">添加照片</view>
          <view class="helper">从相册选择，开始你的拼贴</view>
        </view>
      </button>

      <button class="material-start" bindtap="openAssetsTab">
        <view class="quick-icon">
          <view class="quick-paper back"></view>
          <view class="quick-paper front"></view>
        </view>
        <view class="material-copy">
          <view>从素材包开始</view>
        </view>
        <view class="material-arrow">›</view>
      </button>

      <block wx:if="{{hasRecentDraft}}">
        <view class="section-head">
          <text>最近草稿</text>
        </view>

        <view class="draft-row">
          <button wx:for="{{recentDrafts}}" wx:key="id" class="draft-thumb" data-id="{{item.id}}" bindtap="openRecentDraft">
            <image wx:if="{{item.thumbnailPath}}" class="draft-preview" src="{{item.thumbnailPath}}" mode="aspectFill"></image>
            <view wx:else class="draft-art">
              <view class="draft-paper"></view>
              <view class="draft-tape"></view>
              <view class="draft-line short"></view>
              <view class="draft-line"></view>
            </view>
          </button>
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:else class="editor-content">
    <view class="editor-safe" style="height: {{statusTop}}px;"></view>
    <view class="editor-topbar" style="margin-top: {{toolbarGap}}px;">
      <view class="top-control icon-button back-button" bindtap="backToEmpty" aria-label="返回">
        <image class="line-icon" src="/assets/icons/line-back.svg" mode="aspectFit"></image>
      </view>
      <view class="top-control ratio-pill" bindtap="toggleRatioPanel">{{ratio}}</view>
      <view class="editor-actions">
        <view class="top-control icon-button {{canUndo ? '' : 'disabled'}}" bindtap="undo" aria-label="撤销">
          <image class="line-icon" src="/assets/icons/line-undo.svg" mode="aspectFit"></image>
        </view>
        <view class="top-control icon-button {{canRedo ? '' : 'disabled'}}" bindtap="redo" aria-label="重做">
          <image class="line-icon" src="/assets/icons/line-redo.svg" mode="aspectFit"></image>
        </view>
        <view class="top-control export-btn {{exporting ? 'disabled' : ''}}" bindtap="exportImage">{{exporting ? '导出中' : '导出'}}</view>
      </view>
    </view>
    <cover-view wx:if="{{ratioPanelVisible}}" class="ratio-popover" style="top: {{ratioPopoverTop}}px;">
      <cover-view wx:for="{{ratios}}" wx:key="*this" class="ratio-option {{ratio === item ? 'active' : ''}}" data-ratio="{{item}}" bindtap="changeRatio">{{item}}</cover-view>
    </cover-view>

    <view wx:if="{{!cropEditing && !scissorEditing && !embossEditing}}" class="canvas-stage {{activeDrawer || activePalette || selectedLayerId || textInputVisible || straightCutEditing ? 'panel-active' : ''}} {{textInputVisible ? 'text-editing' : ''}}" bindtap="dismissFloatingPanels">
      <view class="canvas-shell" style="width: {{canvasCssWidth}}px; height: {{canvasCssHeight}}px;">
        <canvas
          type="2d"
          id="spikeCanvas"
          class="canvas"
          style="width: {{canvasCssWidth}}px; height: {{canvasCssHeight}}px;"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchEnd"
          catchtap="noopCanvasTap"
        ></canvas>
        <canvas
          wx:if="{{straightCutEditing}}"
          type="2d"
          id="straightCutCanvas"
          class="straight-cut-canvas"
          style="width: {{canvasCssWidth}}px; height: {{canvasCssHeight}}px;"
          catchtouchstart="onStraightCutTouchStart"
          catchtouchmove="onStraightCutTouchMove"
          catchtouchend="onStraightCutTouchEnd"
          catchtouchcancel="onStraightCutTouchEnd"
        ></canvas>
      </view>
    </view>

    <cover-view wx:if="{{straightCutEditing}}" class="straight-cut-actions">
      <cover-view class="straight-cut-button secondary" bindtap="cancelStraightCut">取消</cover-view>
      <cover-view class="straight-cut-button" bindtap="confirmStraightCut">完成</cover-view>
    </cover-view>

    <view wx:if="{{cropEditing}}" class="crop-fullscreen">
      <view class="crop-topbar" style="top: {{chromeTop}}px;">
        <view class="crop-cancel" bindtap="cancelCrop">取消</view>
        <view class="crop-title">裁切</view>
        <view class="crop-done" style="right: {{cropDoneRight}}px;" bindtap="confirmCrop">完成</view>
      </view>
      <image class="crop-preview-image" src="{{cropImageSrc}}" mode="scaleToFill" style="{{cropImageStyle}}"></image>
      <view class="crop-box" style="{{cropBoxStyle}}">
        <view class="crop-box-line line-h line-1"></view>
        <view class="crop-box-line line-h line-2"></view>
        <view class="crop-box-line line-v line-1"></view>
        <view class="crop-box-line line-v line-2"></view>
        <view class="crop-handle handle-tl"></view>
        <view class="crop-handle handle-tr"></view>
        <view class="crop-handle handle-br"></view>
        <view class="crop-handle handle-bl"></view>
      </view>
      <view class="crop-hit-area" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd"></view>
      <view class="crop-bottom">
        <scroll-view scroll-x class="crop-ratio-row">
          <view wx:for="{{cropRatios}}" wx:key="value" class="crop-ratio {{cropRatio === item.value ? 'active' : ''}}" data-ratio="{{item.value}}" bindtap="setCropRatio">{{item.label}}</view>
          <view class="crop-ratio reset" bindtap="resetCrop">还原</view>
        </scroll-view>
      </view>
    </view>

    <canvas
      type="2d"
      id="scissorCanvas"
      class="scissor-edit-canvas"
      style="{{scissorEditing ? scissorImageStyle : 'left:-9999px;top:-9999px;width:1px;height:1px;'}}"
      catchtouchstart="onScissorTouchStart"
      catchtouchmove="onScissorTouchMove"
      catchtouchend="onScissorTouchEnd"
      catchtouchcancel="onScissorTouchEnd"
    ></canvas>

    <view wx:if="{{scissorEditing}}" class="scissor-fullscreen">
      <view class="crop-topbar" style="top: {{chromeTop}}px;">
        <view class="crop-cancel" bindtap="cancelScissorCut">取消</view>
        <view class="crop-title">涂抹剪</view>
        <view class="crop-done {{scissorHasMask && !scissorBusy ? '' : 'disabled'}}" style="right: {{cropDoneRight}}px;" bindtap="confirmScissorCut">{{scissorBusy ? '处理中' : '完成'}}</view>
      </view>
      <view class="crop-hit-area scissor-hit-area" catchtouchstart="onScissorTouchStart" catchtouchmove="onScissorTouchMove" catchtouchend="onScissorTouchEnd" catchtouchcancel="onScissorTouchEnd"></view>
      <view class="scissor-bottom">
        <view class="scissor-actions">
          <view class="scissor-action {{scissorHasMask && !scissorBusy ? '' : 'disabled'}}" bindtap="clearScissorMask">清空</view>
        </view>
      </view>
    </view>

    <view wx:if="{{embossEditing}}" class="emboss-fullscreen">
      <view class="crop-topbar" style="top: {{chromeTop}}px;">
        <view class="crop-cancel" bindtap="cancelEmbossEdit">取消</view>
        <view class="crop-title">压花</view>
        <view class="crop-done" style="right: {{cropDoneRight}}px;" bindtap="confirmEmbossEdit">完成</view>
      </view>
      <image class="emboss-preview-image" src="{{embossImageSrc}}" mode="scaleToFill" style="{{embossImageStyle}}"></image>
      <view class="emboss-dim"></view>
      <view class="emboss-mask" style="{{embossMaskStyle}}">
        <view class="emboss-mask-shape emboss-mask-{{embossMaskShapeClass}}"></view>
        <view class="emboss-handle handle-tl"></view>
        <view class="emboss-handle handle-tr"></view>
        <view class="emboss-handle handle-br"></view>
        <view class="emboss-handle handle-bl"></view>
      </view>
      <view class="crop-hit-area emboss-hit-area" catchtouchstart="onEmbossTouchStart" catchtouchmove="onEmbossTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd"></view>
      <view class="emboss-bottom">
        <scroll-view scroll-x class="emboss-shape-row">
          <view wx:for="{{embossShapes}}" wx:key="value" class="emboss-shape-option {{embossShape === item.value ? 'active' : ''}}" data-shape="{{item.value}}" bindtap="selectEmbossShape">
            <view class="emboss-option-icon emboss-option-{{item.value}}"></view>
            <view class="emboss-option-label">{{item.label}}</view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view wx:if="{{selectedLayerId && !textInputVisible && !cropEditing && !scissorEditing && !embossEditing && !straightCutEditing}}" class="layer-toolbar">
      <view class="layer-head">
        <view class="layer-title">已选中图层</view>
        <view wx:if="{{selectedLayerType === 'text'}}" class="panel-link" bindtap="editSelectedText">编辑文字</view>
      </view>
      <scroll-view scroll-x class="layer-actions-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="layer-actions-track">
          <view class="layer-action" data-action="up" bindtap="applyLayerAction"><image class="la-icon la-icon-img" src="/assets/icons/layer-actions/move-up.png" mode="aspectFit"></image><view>上移</view></view>
          <view class="layer-action" data-action="down" bindtap="applyLayerAction"><image class="la-icon la-icon-img" src="/assets/icons/layer-actions/move-down.png" mode="aspectFit"></image><view>下移</view></view>
          <view class="layer-action" data-action="copy" bindtap="applyLayerAction"><view class="la-icon la-copy-icon"><view class="copy-back"></view><view class="copy-front"></view></view><view>复制</view></view>
          <view class="layer-action" data-action="delete" bindtap="applyLayerAction"><image class="la-icon la-icon-img" src="/assets/icons/layer-actions/delete.png" mode="aspectFit"></image><view>删除</view></view>
          <view wx:if="{{selectedLayerType === 'image'}}" class="layer-action" data-action="crop" bindtap="applyLayerAction"><view class="la-icon la-crop-icon"><view class="crop-corner crop-corner-a"></view><view class="crop-corner crop-corner-b"></view></view><view>裁切</view></view>
          <view class="layer-action" data-action="shadow" bindtap="applyLayerAction"><view class="la-icon la-shadow-icon"><view class="shadow-back"></view><view class="shadow-front"></view></view><view>阴影</view></view>
          <view class="layer-action" data-action="opacity" bindtap="applyLayerAction"><view class="la-icon la-opacity-icon"><view class="opacity-fill"></view></view><view>透明度</view></view>
          <view class="layer-action" data-action="corner" bindtap="applyLayerAction"><view class="la-icon la-corner-icon"></view><view>圆角</view></view>
          <view wx:if="{{selectedLayerType === 'image'}}" class="layer-action" data-action="cut" bindtap="applyLayerAction"><view class="la-icon la-scissors-line-icon"><view class="scissors-ring scissors-ring-a"></view><view class="scissors-ring scissors-ring-b"></view><view class="scissors-blade scissors-blade-a"></view><view class="scissors-blade scissors-blade-b"></view><view class="scissors-joint"></view></view><view>剪刀</view></view>
          <view wx:if="{{selectedLayerType !== 'text'}}" class="layer-action" data-action="shape" bindtap="applyLayerAction"><view class="la-icon la-emboss-icon"><view class="emboss-mark emboss-mark-a"></view><view class="emboss-mark emboss-mark-b"></view></view><view>压花</view></view>
          <view class="layer-action" data-action="tear" bindtap="applyLayerAction"><view class="la-icon la-tear-icon"><view class="tear-line tear-line-a"></view><view class="tear-line tear-line-b"></view></view><view>撕边</view></view>
        </view>
      </scroll-view>
    </view>

    <block wx:if="{{((!selectedLayerId || textInputVisible) || activePalette === 'cut' || activePalette === 'shape') && !cropEditing && !scissorEditing && !embossEditing && !straightCutEditing}}">
      <cover-view wx:if="{{activePalette === 'cut'}}" class="tool-palette cut-palette {{selectedLayerId ? 'layer-cut-palette' : ''}}">
        <cover-view class="palette-tool palette-tool-0" data-style="straight" bindtap="selectCutStyle">
          <cover-image class="cut-icon cut-icon-straight" src="/assets/icons/scissors/bolang.png"></cover-image>
          <cover-view class="palette-label">直线剪</cover-view>
        </cover-view>
        <cover-view class="palette-tool palette-tool-1" data-style="wave" bindtap="selectCutStyle">
          <cover-image class="cut-icon" src="/assets/icons/scissors/zhijiao.png"></cover-image>
          <cover-view class="palette-label">波浪剪</cover-view>
        </cover-view>
        <cover-view class="palette-tool palette-tool-2 active" data-style="free" bindtap="selectCutStyle">
          <cover-image class="cut-icon" src="/assets/icons/scissors/tumo.png"></cover-image>
          <cover-view class="palette-label">涂抹剪</cover-view>
        </cover-view>
        <cover-view class="palette-tool palette-tool-3 {{backgroundRemoving ? 'disabled' : ''}}" data-style="subject" bindtap="selectCutStyle">
          <cover-image class="cut-icon" src="/assets/icons/scissors/zhuti.png"></cover-image>
          <cover-view class="palette-label">{{backgroundRemoving ? '处理中' : '主体剪'}}</cover-view>
        </cover-view>
      </cover-view>

      <cover-view wx:if="{{activePalette === 'shape'}}" class="tool-palette shape-palette {{selectedLayerId ? 'layer-shape-palette' : ''}}">
        <cover-view class="palette-tool palette-tool-0 active" data-shape="circle" bindtap="addShape">
          <cover-view class="emboss-3d circle"></cover-view>
          <cover-view class="palette-label">圆形</cover-view>
        </cover-view>
        <cover-view class="palette-tool palette-tool-1" data-shape="heart" bindtap="addShape">
          <cover-view class="emboss-3d heart"></cover-view>
          <cover-view class="palette-label">心形</cover-view>
        </cover-view>
        <cover-view class="palette-tool palette-tool-2" data-shape="star" bindtap="addShape">
          <cover-view class="emboss-3d star"></cover-view>
          <cover-view class="palette-label">星形</cover-view>
        </cover-view>
        <cover-view class="palette-tool palette-tool-3" data-shape="tag" bindtap="addShape">
          <cover-view class="emboss-3d tag"></cover-view>
          <cover-view class="palette-label">标签</cover-view>
        </cover-view>
        <cover-view class="palette-tool palette-tool-4" data-shape="stamp" bindtap="addShape">
          <cover-view class="emboss-3d stamp"></cover-view>
          <cover-view class="palette-label">邮票</cover-view>
        </cover-view>
      </cover-view>

      <input
        wx:if="{{textInputVisible}}"
        class="keyboard-input-proxy"
        value="{{textDraft}}"
        placeholder="输入要放到画布上的文字"
        focus="{{textInputVisible}}"
        adjust-position="{{false}}"
        cursor-spacing="0"
        hold-keyboard="{{true}}"
        bindfocus="onTextFocus"
        bindinput="onTextInput"
        bindkeyboardheightchange="onTextKeyboardHeightChange"
        confirm-type="done"
        bindconfirm="confirmText"
      />

      <view wx:if="{{textInputVisible}}" class="text-editor-panel" style="bottom: {{textPanelBottom}}px;">
        <view class="local-panel-head">
          <view class="local-panel-cancel" bindtap="cancelText">取消</view>
          <view class="local-panel-title">文字</view>
          <view class="local-panel-done" bindtap="confirmText">完成</view>
        </view>
        <view wx:if="{{textToolMode === 'font'}}" class="text-option-row font-strip">
          <view
            wx:for="{{textFonts}}"
            wx:key="id"
            class="{{textFont === item.id ? 'active' : ''}}"
            data-font-id="{{item.id}}"
            data-index="{{index}}"
            style="font-family: {{item.family}}, sans-serif;"
            bindtap="setTextFont"
          >{{item.previewText}}</view>
        </view>
        <view wx:if="{{textToolMode === 'color'}}" class="text-option-row swatch-row">
          <view wx:for="{{textColors}}" wx:key="value" class="swatch swatch-{{index}} {{textColor === item.value ? 'active' : ''}}" data-color="{{item.value}}" data-index="{{index}}" bindtap="setTextColor"></view>
        </view>
        <view wx:if="{{textToolMode === 'size'}}" class="text-option-row text-control-row">
          <view class="size-steps">
            <view class="{{textSize === 42 ? 'active' : ''}}" data-size="42" bindtap="setTextSize">小</view>
            <view class="{{textSize === 54 ? 'active' : ''}}" data-size="54" bindtap="setTextSize">中</view>
            <view class="{{textSize === 68 ? 'active' : ''}}" data-size="68" bindtap="setTextSize">大</view>
            <view class="{{textSize === 88 ? 'active' : ''}}" data-size="88" bindtap="setTextSize">超大</view>
          </view>
        </view>
        <view wx:if="{{textToolMode === 'background'}}" class="text-option-row background-strip">
          <view wx:for="{{textBackgrounds}}" wx:key="*this" class="{{textBackground === item ? 'active' : ''}}" data-background="{{item}}" bindtap="setTextBackground">{{item}}</view>
        </view>
        <view wx:if="{{textToolMode === 'opacity'}}" class="text-option-row text-control-row">
          <view class="size-steps">
            <view class="{{textOpacity === 45 ? 'active' : ''}}" data-opacity="45" bindtap="setTextOpacity">45%</view>
            <view class="{{textOpacity === 70 ? 'active' : ''}}" data-opacity="70" bindtap="setTextOpacity">70%</view>
            <view class="{{textOpacity === 100 ? 'active' : ''}}" data-opacity="100" bindtap="setTextOpacity">100%</view>
          </view>
        </view>
        <view class="text-style-row">
          <view class="text-style text-style-0 {{textToolMode === 'font' ? 'active' : ''}}" data-mode="font" bindtap="setTextToolMode"><view class="text-style-icon">B</view><view class="text-style-label">字体</view></view>
          <view class="text-style text-style-1 {{textToolMode === 'color' ? 'active' : ''}}" data-mode="color" bindtap="setTextToolMode"><view class="text-style-icon">●</view><view class="text-style-label">颜色</view></view>
          <view class="text-style text-style-2 {{textToolMode === 'size' ? 'active' : ''}}" data-mode="size" bindtap="setTextToolMode"><view class="text-style-icon">A</view><view class="text-style-label">大小</view></view>
          <view class="text-style text-style-3 {{textToolMode === 'background' ? 'active' : ''}}" data-mode="background" bindtap="setTextToolMode"><view class="text-style-icon">□</view><view class="text-style-label">底色</view></view>
          <view class="text-style text-style-4 {{textToolMode === 'opacity' ? 'active' : ''}}" data-mode="opacity" bindtap="setTextToolMode"><view class="text-style-icon">▦</view><view class="text-style-label">透明</view></view>
        </view>
      </view>

      <block wx:if="{{activeDrawer}}">
        <view class="drawer-backdrop" bindtap="closeDrawer"></view>
        <view class="drawer">
          <view class="drawer-handle"></view>

          <block wx:if="{{activeDrawer === 'asset'}}">
            <view class="drawer-title-row">
              <view wx:if="{{activeAssetPack}}" class="drawer-return-zone" bindtap="backToAssetPacks">
                <view class="drawer-back-link">‹</view>
                <view class="drawer-title with-back">{{activeAssetPack.name}}</view>
              </view>
              <view wx:else class="drawer-title">素材</view>
              <view class="link-button" bindtap="openAssetsTab">查看全部</view>
            </view>
            <block wx:if="{{!activeAssetPack}}">
              <view class="chip-row">
                <view
                  wx:for="{{assetCategories}}"
                  wx:key="*this"
                  class="chip {{activeAssetCategory === item ? 'active' : ''}}"
                  data-category="{{item}}"
                  bindtap="selectAssetCategory"
                >{{item}}</view>
              </view>
              <scroll-view scroll-y class="asset-pack-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
                <view
                  wx:for="{{visibleAssetPacks}}"
                  wx:key="id"
                  class="asset-pack-card"
                  style="background: {{item.tone}};"
                  data-pack="{{item.id}}"
                  bindtap="openAssetPack"
                >
                  <image class="asset-pack-cover" src="{{item.cover}}" mode="aspectFit"></image>
                </view>
              </scroll-view>
            </block>
            <block wx:else>
              <scroll-view scroll-y class="asset-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
                <view
                  wx:for="{{activeAssetPackItems}}"
                  wx:key="id"
                  class="asset-card"
                  data-asset-id="{{item.id}}"
                  bindtap="addConfiguredAsset"
                >
                  <image class="asset-thumb" src="{{item.thumb}}" style="{{item.panelPreviewStyle}}" mode="aspectFit"></image>
                </view>
              </scroll-view>
            </block>
          </block>

          <block wx:if="{{activeDrawer === 'tape'}}">
            <view class="drawer-title-row">
              <view class="drawer-title">胶带</view>
            </view>
            <view class="asset-grid">
              <view class="asset-tile tile-0" data-color="#ead48a" bindtap="addTape"><view class="tape-preview yellow"></view></view>
              <view class="asset-tile tile-1" data-color="#8d9b8e" bindtap="addTape"><view class="tape-preview green"></view></view>
              <view class="asset-tile tile-2" data-color="#c7b29a" bindtap="addTape"><view class="tape-preview kraft"></view></view>
              <view class="asset-tile tile-3" data-color="#1f1f1f" bindtap="addTape"><view class="tape-preview black"></view></view>
              <view class="asset-tile tile-4" data-color="#f1d4c8" bindtap="addTape"><view class="tape-preview pink"></view></view>
              <view class="asset-tile tile-5" data-color="#c4c8ce" bindtap="addTape"><view class="tape-preview gray"></view></view>
            </view>
          </block>

          <block wx:if="{{activeDrawer === 'background'}}">
            <view class="drawer-title-row">
              <view class="drawer-title">背景</view>
            </view>
            <view class="chip-row">
              <view
                wx:for="{{backgroundCategories}}"
                wx:key="*this"
                class="chip {{activeBackgroundCategory === item ? 'active' : ''}}"
                data-category="{{item}}"
                bindtap="selectBackgroundCategory"
              >{{item}}</view>
            </view>
            <scroll-view scroll-y class="background-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
              <view
                wx:for="{{visibleBackgrounds}}"
                wx:key="id"
                class="background-card {{item.source ? 'image-bg' : ''}} {{item.patternClass}}"
                style="background-color: {{item.color}};"
                data-background-id="{{item.id}}"
                bindtap="applyBackground"
              >
                <image wx:if="{{item.thumb}}" class="background-thumb" src="{{item.thumb}}" mode="aspectFill"></image>
                <view class="background-name">{{item.name}}</view>
              </view>
            </scroll-view>
          </block>

        </view>
      </block>

      <cover-view wx:if="{{!textInputVisible && !straightCutEditing && activeDrawer !== 'asset' && activeDrawer !== 'background' && !(selectedLayerId && (activePalette === 'cut' || activePalette === 'shape'))}}" class="main-toolbar">
        <cover-view class="tool tool-0 {{activeTool === 'image' ? 'active' : ''}}" data-tool="image" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/img.png"></cover-image>
          <cover-view class="tool-label">图片</cover-view>
        </cover-view>
        <cover-view class="tool tool-1 {{activeTool === 'asset' ? 'active' : ''}}" data-tool="asset" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/material.png"></cover-image>
          <cover-view class="tool-label">素材</cover-view>
        </cover-view>
        <cover-view class="tool tool-2 {{activeTool === 'background' ? 'active' : ''}}" data-tool="background" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/backpapaer.png"></cover-image>
          <cover-view class="tool-label">背景</cover-view>
        </cover-view>
        <cover-view class="tool tool-3 {{activeTool === 'text' ? 'active' : ''}}" data-tool="text" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/text.png"></cover-image>
          <cover-view class="tool-label">文字</cover-view>
        </cover-view>
        <cover-view class="tool tool-4 {{activeTool === 'cut' ? 'active' : ''}}" data-tool="cut" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/scissors.png"></cover-image>
          <cover-view class="tool-label">剪刀</cover-view>
        </cover-view>
        <cover-view class="tool tool-5 {{activeTool === 'shape' ? 'active' : ''}}" data-tool="shape" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/pattern.png"></cover-image>
          <cover-view class="tool-label">压花</cover-view>
        </cover-view>
      </cover-view>
    </block>
  </view>
</view>
