                        <view wx:for="{{polkaBackgroundColors}}" wx:key="value" class="polka-swatch {{selectedPolkaBackground === item.value ? 'active' : ''}}" style="background-color: {{item.value}};" data-color="{{item.value}}" bindtap="setPolkaPaperBackgroundColor"></view>
