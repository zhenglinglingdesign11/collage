                  </scroll-view>
                </view>
                <view class="polka-paper-add-button" bindtap="addCustomPolkaPaper">添加</view>
              </block>
              <block wx:else>
                <scroll-view scroll-y class="asset-scroll polka-paper-asset-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
                  <view class="asset-list-grid">
                    <view class="asset-card polka-paper-custom-entry" bindtap="beginPolkaPaperCustom">
