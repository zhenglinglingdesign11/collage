<view class="page">
  <scroll-view wx:if="{{isEmptyMode}}" scroll-y class="empty-content" style="padding-top: {{chromeTop}}px;">
    <view class="empty-header">
      <view class="page-title">新拼贴</view>
    </view>

    <view class="empty-workspace">
      <button class="starter-panel upload-zone" bindtap="choosePhoto">
        <view class="upload-content">
          <view class="round-action">+</view>
          <view class="primary-label">添加照片</view>
        </view>
      </button>

      <view class="start-entry-row">
        <button class="start-entry-card blank-start" bindtap="enterBlankCanvas">
          <view class="quick-icon blank-icon">
            <view class="blank-page-icon"></view>
          </view>
          <view class="material-copy">
            <view>从空白画布开始</view>
          </view>
        </button>

        <button class="start-entry-card material-start" bindtap="openAssetsTab">
          <view class="quick-icon">
            <view class="quick-paper back"></view>
            <view class="quick-paper front"></view>
          </view>
          <view class="material-copy">
            <view>从素材包开始</view>
          </view>
        </button>
      </view>

      <block wx:if="{{hasRecentDraft}}">
        <view class="section-head">
          <text>最近草稿</text>
        </view>

        <view class="draft-row">
          <button wx:for="{{recentDrafts}}" wx:key="id" class="draft-thumb" data-id="{{item.id}}" bindtap="openRecentDraft">
            <image wx:if="{{item.thumbnailPath}}" class="draft-preview" src="{{item.thumbnailPath}}" mode="aspectFill"></image>
            <view wx:else class="draft-art">
              <view class="draft-paper"></view>
              <view class="draft-tape"></view>
              <view class="draft-line short"></view>
              <view class="draft-line"></view>
            </view>
          </button>
        </view>
      </block>

      <view class="home-showcase-section">
        <view wx:for="{{homeShowcaseGroups}}" wx:key="id" wx:for-item="group" class="home-showcase-group">
          <view class="section-head home-showcase-head">
            <text>{{group.title}}</text>
          </view>
          <scroll-view scroll-x enhanced="{{true}}" show-scrollbar="{{false}}" class="home-showcase-scroll">
            <view class="home-showcase-track">
              <view wx:for="{{group.items}}" wx:key="id" wx:for-item="showcase" class="home-showcase-card" data-effect="{{showcase.effect}}" data-showcase-id="{{showcase.id}}" data-background-preset-id="{{showcase.backgroundPresetId}}" bindtap="choosePhotoForShowcase" aria-label="选择照片并应用效果">
                <image wx:if="{{showcase.imageSrc}}" class="home-showcase-image" src="{{showcase.imageSrc}}" mode="aspectFill"></image>
                <view wx:elif="{{showcase.previewStyle}}" class="home-showcase-placeholder home-showcase-pattern" style="{{showcase.previewStyle}}">
                  <block wx:if="{{showcase.previewTiles}}">
                    <block wx:for="{{showcase.previewTiles}}" wx:for-item="tile" wx:for-index="tileIndex" wx:key="tileIndex">
                      <image
                        wx:if="{{tile.src}}"
                        class="pattern-preview-tile"
                        src="{{tile.src}}"
                        style="{{tile.style}}"
                        mode="aspectFit"
                      ></image>
                      <view
                        wx:else
                        class="pattern-preview-tile"
                        style="{{tile.style}}"
                      ></view>
                    </block>
                  </block>
                </view>
                <view wx:else class="home-showcase-placeholder home-showcase-{{showcase.tone}}">
                  <view wx:if="{{showcase.tone === 'structure'}}" class="showcase-structure-art">
                  <view class="showcase-paper showcase-paper-back"></view>
                  <view class="showcase-paper showcase-paper-front"></view>
                  <view class="showcase-tape"></view>
                  </view>
                  <view wx:if="{{showcase.tone === 'texture'}}" class="showcase-texture-art">
                  <view class="showcase-texture-sun"></view>
                  <view class="showcase-texture-lines"></view>
                  </view>
                  <view wx:if="{{showcase.tone === 'emboss'}}" class="showcase-emboss-art">
                  <view class="showcase-emboss-paper"></view>
                  <view class="showcase-emboss-heart"></view>
                  </view>
                </view>
                <view class="home-showcase-title">{{showcase.title}}</view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:else class="editor-content">
    <view class="editor-safe" style="height: {{chromeTop}}px;"></view>
    <view class="editor-topbar">
      <view class="top-control icon-button back-button" bindtap="backToEmpty" aria-label="返回">
        <image class="line-icon" src="/assets/icons/line-back.svg" mode="aspectFit"></image>
      </view>
      <view class="top-control ratio-pill" bindtap="toggleRatioPanel">{{ratio}}</view>
      <view class="editor-actions">
        <view class="top-control icon-button {{canUndo ? '' : 'disabled'}}" bindtap="undo" aria-label="撤销">
          <image class="line-icon" src="/assets/icons/line-undo.svg" mode="aspectFit"></image>
        </view>
        <view class="top-control icon-button {{canRedo ? '' : 'disabled'}}" bindtap="redo" aria-label="重做">
          <image class="line-icon" src="/assets/icons/line-redo.svg" mode="aspectFit"></image>
        </view>
        <view class="top-control export-btn {{exporting ? 'disabled' : ''}}" bindtap="exportImage">{{exporting ? '导出中' : '导出'}}</view>
      </view>
    </view>
    <cover-view wx:if="{{ratioPanelVisible}}" class="ratio-popover" style="top: {{ratioPopoverTop}}px;">
      <cover-view wx:for="{{ratios}}" wx:key="*this" class="ratio-option {{ratio === item ? 'active' : ''}}" data-ratio="{{item}}" bindtap="changeRatio">{{item}}</cover-view>
    </cover-view>
    <cover-view wx:if="{{brushDebugEnabled && !brushEditing && !imageEffectEditing && !cropEditing && !scissorEditing && !embossEditing && !straightCutEditing}}" class="brush-dev-entry" bindtap="beginBrushDrawing">画笔DEV</cover-view>
    <cover-view wx:if="{{imageEffectDebugEnabled && !brushEditing && !imageEffectEditing && !cropEditing && !scissorEditing && !embossEditing && !straightCutEditing}}" class="effect-dev-entry" bindtap="beginImageEffectEditing">效果DEV</cover-view>

    <view wx:if="{{!cropEditing && !scissorEditing && !embossEditing}}" class="canvas-stage {{activeDrawer || activePalette || selectedLayerId || textInputVisible || straightCutEditing ? 'panel-active' : ''}} {{selectedLayerId && !activeDrawer && activePalette !== 'effect' && !textInputVisible ? 'layer-editing' : ''}} {{selectedLayerId && !activeDrawer && (activePalette === 'cut' || activePalette === 'shape' || activePalette === 'outline') ? 'layer-palette-editing' : ''}} {{textInputVisible ? 'text-editing' : ''}} {{brushEditing ? 'brush-editing' : ''}} {{activePalette === 'effect' ? 'effect-editing' : ''}}" style="{{canvasStageStyle}}" bindtap="dismissFloatingPanels">
      <view class="canvas-shell" style="width: {{canvasCssWidth}}px; height: {{canvasCssHeight}}px;">
        <canvas
          type="2d"
          id="spikeCanvas"
          class="canvas"
          style="width: {{canvasCssWidth}}px; height: {{canvasCssHeight}}px;"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchEnd"
          catchtap="noopCanvasTap"
        ></canvas>
        <view wx:if="{{textureEffectBusy}}" class="effect-generating-overlay" aria-live="polite">
          <view class="effect-generating-spinner"></view>
          <text>生成中</text>
        </view>
        <canvas
          wx:if="{{straightCutEditing}}"
          type="2d"
          id="straightCutCanvas"
          class="straight-cut-canvas"
          style="width: {{canvasCssWidth}}px; height: {{canvasCssHeight}}px;"
          catchtouchstart="onStraightCutTouchStart"
          catchtouchmove="onStraightCutTouchMove"
          catchtouchend="onStraightCutTouchEnd"
          catchtouchcancel="onStraightCutTouchEnd"
        ></canvas>
        <cover-view
          wx:if="{{selectedLayerId && selectedLayerLockStyle}}"
          class="selected-layer-lock {{selectedLayerLocked ? 'locked' : ''}}"
          style="{{selectedLayerLockStyle}}"
          catchtap="toggleSelectedLayerLock"
          aria-label="{{selectedLayerLocked ? '解锁图层' : '锁定图层'}}"
        >
          <cover-image class="selected-layer-lock-icon" src="{{selectedLayerLocked ? '/assets/icons/layer-actions/lock-outline.png' : '/assets/icons/layer-actions/unlock-outline.png'}}"></cover-image>
        </cover-view>
        <cover-view
          wx:if="{{selectedLayerId && selectedLayerReplaceStyle}}"
          class="selected-layer-replace"
          style="{{selectedLayerReplaceStyle}}"
          catchtap="replaceSelectedLayerPhoto"
          aria-label="替换图片"
        ><cover-image class="selected-layer-replace-icon" src="/assets/icons/layer-actions/replace.png"></cover-image></cover-view>
      </view>
    </view>

    <cover-view wx:if="{{straightCutEditing}}" class="straight-cut-actions">
      <cover-view class="straight-cut-button secondary" bindtap="cancelStraightCut">取消</cover-view>
      <cover-view class="straight-cut-button" bindtap="confirmStraightCut">完成</cover-view>
    </cover-view>

    <cover-view wx:if="{{brushEditing}}" class="brush-dev-panel">
      <cover-view class="brush-panel-head">
        <cover-view class="brush-panel-cancel" bindtap="cancelBrushDrawing">取消</cover-view>
        <cover-view class="brush-panel-title">装饰笔刷</cover-view>
        <cover-view class="brush-panel-done {{brushStrokeCount ? '' : 'disabled'}}" bindtap="confirmBrushDrawing">完成</cover-view>
      </cover-view>
      <cover-view class="brush-section">
        <cover-view class="brush-section-title">笔刷</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{brushTypes}}" wx:key="value" class="brush-type {{brushType === item.value ? 'active' : ''}}" data-type="{{item.value}}" bindtap="setBrushType">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view class="brush-section brush-section-controls">
        <cover-view class="brush-section-title">颜色</cover-view>
        <cover-view class="brush-color-row">
          <cover-view wx:for="{{brushColors}}" wx:key="value" class="brush-color {{brushColor === item.value ? 'active' : ''}}" style="background: {{item.value}};" data-color="{{item.value}}" bindtap="setBrushColor"></cover-view>
        </cover-view>
        <cover-view class="brush-section-title brush-size-title">粗细</cover-view>
        <cover-view class="brush-size-row">
          <cover-view wx:for="{{brushSizes}}" wx:key="value" class="brush-size {{brushSize === item.value ? 'active' : ''}}" data-size="{{item.value}}" bindtap="setBrushSize">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view class="brush-panel-actions">
        <cover-view class="brush-panel-action {{brushStrokeCount ? '' : 'disabled'}}" bindtap="undoBrushStroke">撤销上一笔</cover-view>
        <cover-view class="brush-panel-action danger {{brushStrokeCount ? '' : 'disabled'}}" bindtap="clearBrushDrawing">清空</cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{imageEffectEditing}}" class="brush-dev-panel image-effect-panel">
      <cover-view class="brush-panel-head">
        <cover-view class="brush-panel-cancel" bindtap="cancelImageEffectEditing">取消</cover-view>
        <cover-view class="brush-panel-title">图像效果DEV</cover-view>
        <cover-view class="brush-panel-done {{imageEffectBusy ? 'disabled' : ''}}" bindtap="applyImageEffect">{{imageEffectBusy ? '生成中' : '完成'}}</cover-view>
      </cover-view>
      <cover-view class="brush-section">
        <cover-view class="brush-section-title">效果</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{imageEffectTypes}}" wx:key="value" class="brush-type {{imageEffectType === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setImageEffectType">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view wx:if="{{imageEffectType === 'cross-stitch'}}" class="brush-section">
        <cover-view class="brush-section-title">网格</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{crossStitchGrids}}" wx:key="value" class="brush-type {{crossStitchGrid === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setCrossStitchGrid">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view wx:if="{{imageEffectType === 'cross-stitch'}}" class="brush-section">
        <cover-view class="brush-section-title">色数</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{crossStitchColorOptions}}" wx:key="value" class="brush-type {{crossStitchColors === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setCrossStitchColors">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view wx:if="{{imageEffectType === 'cross-stitch'}}" class="brush-section">
        <cover-view class="brush-section-title">样式</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{crossStitchStyles}}" wx:key="value" class="brush-type {{crossStitchStyle === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setCrossStitchStyle">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view wx:if="{{imageEffectType === 'matisse'}}" class="brush-section">
        <cover-view class="brush-section-title">复杂度</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{matisseDetails}}" wx:key="value" class="brush-type {{matisseDetail === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setMatisseDetail">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view wx:if="{{imageEffectType === 'matisse'}}" class="brush-section">
        <cover-view class="brush-section-title">色板</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{matissePalettes}}" wx:key="value" class="brush-type {{matissePalette === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setMatissePalette">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view wx:if="{{imageEffectType === 'botanical'}}" class="brush-section">
        <cover-view class="brush-section-title">色调</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{botanicalTones}}" wx:key="value" class="brush-type {{botanicalTone === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setBotanicalTone">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
      <cover-view wx:if="{{imageEffectType === 'botanical'}}" class="brush-section">
        <cover-view class="brush-section-title">线稿</cover-view>
        <cover-view class="brush-type-grid">
          <cover-view wx:for="{{botanicalDetails}}" wx:key="value" class="brush-type {{botanicalDetail === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="setBotanicalDetail">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
    </cover-view>

    <view wx:if="{{cropEditing}}" class="crop-fullscreen">
      <view class="crop-topbar" style="top: {{chromeTop}}px;">
        <view class="crop-cancel" bindtap="cancelCrop">取消</view>
        <view class="crop-title">裁切</view>
        <view class="crop-done" style="right: {{cropDoneRight}}px;" bindtap="confirmCrop">完成</view>
      </view>
      <image class="crop-preview-image" src="{{cropImageSrc}}" mode="scaleToFill" style="{{cropImageStyle}}"></image>
      <view class="crop-box" style="{{cropBoxStyle}}">
        <view class="crop-box-line line-h line-1"></view>
        <view class="crop-box-line line-h line-2"></view>
        <view class="crop-box-line line-v line-1"></view>
        <view class="crop-box-line line-v line-2"></view>
        <view class="crop-handle handle-tl"></view>
        <view class="crop-handle handle-tr"></view>
        <view class="crop-handle handle-br"></view>
        <view class="crop-handle handle-bl"></view>
      </view>
      <view class="crop-hit-area" catchtouchstart="onCropTouchStart" catchtouchmove="onCropTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd"></view>
      <view class="crop-bottom">
        <scroll-view scroll-x class="crop-ratio-row">
          <view wx:for="{{cropRatios}}" wx:key="value" class="crop-ratio {{cropRatio === item.value ? 'active' : ''}}" data-ratio="{{item.value}}" bindtap="setCropRatio">{{item.label}}</view>
          <view class="crop-ratio reset" bindtap="resetCrop">还原</view>
        </scroll-view>
      </view>
    </view>

    <canvas
      type="2d"
      id="scissorCanvas"
      class="scissor-edit-canvas"
      style="{{scissorEditing ? scissorImageStyle : 'left:-9999px;top:-9999px;width:1px;height:1px;'}}"
      catchtouchstart="onScissorTouchStart"
      catchtouchmove="onScissorTouchMove"
      catchtouchend="onScissorTouchEnd"
      catchtouchcancel="onScissorTouchEnd"
    ></canvas>

    <view wx:if="{{scissorEditing}}" class="scissor-fullscreen">
      <view class="crop-topbar" style="top: {{chromeTop}}px;">
        <view class="crop-cancel" bindtap="cancelScissorCut">取消</view>
        <view class="crop-title">涂抹剪</view>
        <view class="crop-done {{scissorHasMask && !scissorBusy ? '' : 'disabled'}}" style="right: {{cropDoneRight}}px;" bindtap="confirmScissorCut">{{scissorBusy ? '处理中' : '完成'}}</view>
      </view>
      <view class="crop-hit-area scissor-hit-area" catchtouchstart="onScissorTouchStart" catchtouchmove="onScissorTouchMove" catchtouchend="onScissorTouchEnd" catchtouchcancel="onScissorTouchEnd"></view>
      <view class="scissor-bottom">
        <view class="scissor-actions">
          <view class="scissor-action {{scissorHasMask && !scissorBusy ? '' : 'disabled'}}" bindtap="clearScissorMask">清空</view>
        </view>
      </view>
    </view>

    <view wx:if="{{embossEditing}}" class="emboss-fullscreen">
      <view class="crop-topbar" style="top: {{chromeTop}}px;">
        <view class="crop-cancel" bindtap="cancelEmbossEdit">取消</view>
        <view class="crop-title">压花</view>
        <view class="crop-done" style="right: {{cropDoneRight}}px;" bindtap="confirmEmbossEdit">完成</view>
      </view>
      <view class="emboss-preview-viewport" style="{{embossPreviewStyle}}">
        <image class="emboss-preview-image" src="{{embossImageSrc}}" mode="scaleToFill" style="{{embossImageStyle}}"></image>
      </view>
      <view class="emboss-dim"></view>
      <view class="emboss-mask" style="{{embossMaskStyle}}">
        <view class="emboss-mask-shape emboss-mask-{{embossMaskShapeClass}}">
          <view class="emboss-mask-fill emboss-mask-{{embossMaskShapeClass}}"></view>
        </view>
        <view class="emboss-handle handle-tl"></view>
        <view class="emboss-handle handle-tr"></view>
        <view class="emboss-handle handle-br"></view>
        <view class="emboss-handle handle-bl"></view>
      </view>
      <view class="crop-hit-area emboss-hit-area" catchtouchstart="onEmbossTouchStart" catchtouchmove="onEmbossTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd"></view>
      <view class="emboss-bottom">
        <scroll-view scroll-x enhanced="{{true}}" show-scrollbar="{{false}}" class="emboss-shape-row">
          <view wx:for="{{embossShapes}}" wx:key="value" class="emboss-shape-option {{embossShape === item.value ? 'active' : ''}}" data-shape="{{item.value}}" bindtap="selectEmbossShape">
            <view class="emboss-option-icon emboss-option-{{item.value}}"></view>
            <view class="emboss-option-label">{{item.label}}</view>
          </view>
        </scroll-view>
        <view class="emboss-actions">
          <view class="emboss-sub-action {{embossAspectLocked ? 'active' : ''}}" bindtap="toggleEmbossAspectLock">固定比例</view>
          <view class="emboss-sub-action" bindtap="resetEmbossMask">恢复初始蒙版</view>
        </view>
      </view>
    </view>

    <view wx:if="{{selectedLayerId && !activeDrawer && activePalette !== 'effect' && !textInputVisible && !cropEditing && !scissorEditing && !embossEditing && !straightCutEditing}}" class="layer-toolbar {{activePalette === 'cut' || activePalette === 'shape' || activePalette === 'outline' ? 'palette-active' : ''}}">
      <view class="layer-head">
        <view class="layer-title">已选中图层</view>
        <view wx:if="{{selectedLayerType === 'text'}}" class="panel-link" bindtap="editSelectedText">编辑文字</view>
      </view>
      <scroll-view scroll-x="{{activePalette === 'cut' || activePalette === 'shape' || activePalette === 'outline'}}" scroll-left="{{layerActionsScrollLeft}}" scroll-into-view="{{layerActionsScrollIntoView}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="layer-actions-grid {{activePalette === 'cut' || activePalette === 'shape' || activePalette === 'outline' ? 'single-row' : ''}}">
        <view class="layer-actions-content">
          <view class="layer-action" data-action="up" bindtap="applyLayerAction"><image class="la-icon la-icon-img" src="/assets/icons/layer-actions/move-up.png" mode="aspectFit"></image><view>上移</view></view>
          <view class="layer-action" data-action="down" bindtap="applyLayerAction"><image class="la-icon la-icon-img" src="/assets/icons/layer-actions/move-down.png" mode="aspectFit"></image><view>下移</view></view>
          <view class="layer-action" data-action="copy" bindtap="applyLayerAction"><view class="la-icon la-copy-icon"><view class="copy-back"></view><view class="copy-front"></view></view><view>复制</view></view>
          <view class="layer-action" data-action="delete" bindtap="applyLayerAction"><image class="la-icon la-icon-img" src="/assets/icons/layer-actions/delete.png" mode="aspectFit"></image><view>删除</view></view>
          <view wx:if="{{selectedCollageSlot}}" class="layer-action" data-action="deleteCollage" bindtap="applyLayerAction"><image class="la-icon la-icon-img" src="/assets/icons/layer-actions/delete.png" mode="aspectFit"></image><view>删拼图</view></view>
          <view wx:if="{{selectedLayerType === 'image'}}" class="layer-action" data-action="crop" bindtap="applyLayerAction"><view class="la-icon la-crop-icon"><view class="crop-corner crop-corner-a"></view><view class="crop-corner crop-corner-b"></view></view><view>裁切</view></view>
          <view class="layer-action" data-action="shadow" bindtap="applyLayerAction"><view class="la-icon la-shadow-icon"><view class="shadow-back"></view><view class="shadow-front"></view></view><view>阴影</view></view>
          <view class="layer-action" data-action="opacity" bindtap="applyLayerAction"><view class="la-icon la-opacity-icon"><view class="opacity-fill"></view></view><view>透明度</view></view>
          <view class="layer-action" data-action="corner" bindtap="applyLayerAction"><view class="la-icon la-corner-icon"></view><view>圆角</view></view>
          <view id="layer-action-outline" class="layer-action" data-action="outline" bindtap="applyLayerAction"><view class="la-icon la-outline-icon"><view class="outline-back"></view><view class="outline-front"></view></view><view>描边</view></view>
          <view wx:if="{{selectedLayerType !== 'text'}}" class="layer-action" data-action="effect" bindtap="applyLayerAction"><view class="la-icon la-effect-icon"><view class="effect-paper"></view><view class="effect-tape"></view></view><view>效果</view></view>
          <view wx:if="{{selectedLayerType === 'image' || selectedLayerType === 'sticker' || selectedLayerType === 'paper'}}" id="layer-action-cut" class="layer-action" data-action="cut" bindtap="applyLayerAction"><view class="la-icon la-scissors-line-icon"><view class="scissors-ring scissors-ring-a"></view><view class="scissors-ring scissors-ring-b"></view><view class="scissors-blade scissors-blade-a"></view><view class="scissors-blade scissors-blade-b"></view><view class="scissors-joint"></view></view><view>剪刀</view></view>
