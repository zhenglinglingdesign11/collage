                  <view class="polka-config-label">底色</view>
                  <scroll-view scroll-x class="polka-swatch-row" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view wx:for="{{polkaBackgroundColors}}" wx:key="value" class="polka-swatch {{selectedPolkaBackground === item.value ? 'active' : ''}}" style="background-color: {{item.value}};" data-color="{{item.value}}" bindtap="setPolkaBackgroundColor"></view>
                  </scroll-view>
                </view>
                <view class="polka-config-row">
                  <view class="polka-config-label">点色</view>
                  <scroll-view scroll-x class="polka-swatch-row" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view wx:for="{{polkaDotColors}}" wx:key="value" class="polka-swatch {{selectedPolkaDotColor === item.value ? 'active' : ''}}" style="background-color: {{item.value}};" data-color="{{item.value}}" bindtap="setPolkaDotColor"></view>
                  </scroll-view>
                </view>
                <view class="polka-config-row compact">
                  <view class="polka-config-label">大小</view>
                  <scroll-view scroll-x class="polka-segment-row" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view wx:for="{{polkaDotSizes}}" wx:key="value" class="polka-segment {{selectedPolkaDotRadius === item.value ? 'active' : ''}}" data-radius="{{item.value}}" bindtap="setPolkaDotSize">{{item.label}}</view>
                  </scroll-view>
                </view>
                <view class="polka-config-row compact">
                  <view class="polka-config-label">密度</view>
                  <scroll-view scroll-x class="polka-segment-row" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view wx:for="{{polkaDensities}}" wx:key="value" class="polka-segment {{selectedPolkaGap === item.value ? 'active' : ''}}" data-gap="{{item.value}}" bindtap="setPolkaDensity">{{item.label}}</view>
                  </scroll-view>
                </view>
                <view class="polka-config-row compact">
                  <view class="polka-config-label">样式</view>
                  <scroll-view scroll-x class="polka-segment-row" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view wx:for="{{polkaStyles}}" wx:key="value" class="polka-segment {{selectedPolkaStyle === item.value ? 'active' : ''}}" data-style="{{item.value}}" bindtap="setPolkaStyle">{{item.label}}</view>
                  </scroll-view>
                </view>
                <view class="polka-config-row compact">
                  <view class="polka-config-label">透明</view>
                  <scroll-view scroll-x class="polka-segment-row" enhanced="{{true}}" show-scrollbar="{{false}}">
                    <view wx:for="{{polkaOpacities}}" wx:key="value" class="polka-segment {{selectedPolkaOpacity === item.value ? 'active' : ''}}" data-opacity="{{item.value}}" bindtap="setPolkaOpacity">{{item.label}}</view>
                  </scroll-view>
                </view>
              </view>
            </block>
          </block>

        </view>
      </block>

      <cover-view wx:if="{{backgroundHintVisible && !activeDrawer && !activePalette && !selectedLayerId && !textInputVisible && !straightCutEditing && !brushEditing && !imageEffectEditing}}" class="background-hint">
        <cover-view class="background-hint-text">更多波点在这里</cover-view>
        <cover-view class="background-hint-arrow"></cover-view>
      </cover-view>

      <cover-view wx:if="{{!textInputVisible && !straightCutEditing && !brushEditing && !imageEffectEditing && activeDrawer !== 'asset' && activeDrawer !== 'background' && !(selectedLayerId && (activePalette === 'cut' || activePalette === 'shape' || activePalette === 'outline' || activePalette === 'effect'))}}" class="main-toolbar">
        <cover-view class="tool tool-0 {{activeTool === 'image' ? 'active' : ''}}" data-tool="image" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/img.png"></cover-image>
          <cover-view class="tool-label">图片</cover-view>
        </cover-view>
        <cover-view class="tool tool-1 {{activeTool === 'asset' ? 'active' : ''}}" data-tool="asset" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/material.png"></cover-image>
          <cover-view class="tool-label">素材</cover-view>
        </cover-view>
        <cover-view class="tool tool-2 {{activeTool === 'background' ? 'active' : ''}}" data-tool="background" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/backpapaer.png"></cover-image>
          <cover-view class="tool-label">背景</cover-view>
        </cover-view>
        <cover-view class="tool tool-3 {{activeTool === 'text' ? 'active' : ''}}" data-tool="text" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/text.png"></cover-image>
          <cover-view class="tool-label">文字</cover-view>
        </cover-view>
        <cover-view class="tool tool-4 {{activeTool === 'cut' ? 'active' : ''}}" data-tool="cut" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/scissors.png"></cover-image>
          <cover-view class="tool-label">剪刀</cover-view>
        </cover-view>
        <cover-view class="tool tool-5 {{activeTool === 'shape' ? 'active' : ''}}" data-tool="shape" bindtap="openToolPanel">
          <cover-image class="tool-icon" src="/assets/icons/pattern.png"></cover-image>
          <cover-view class="tool-label">压花</cover-view>
        </cover-view>
        <cover-view class="tool tool-6 {{activeTool === 'brush' ? 'active' : ''}}" data-tool="brush" bindtap="openToolPanel">
          <cover-image class="tool-icon brush-tool-icon" src="/assets/icons/brush.png"></cover-image>
          <cover-view class="tool-label">画笔</cover-view>
        </cover-view>
      </cover-view>
    </block>
  </view>
</view>
