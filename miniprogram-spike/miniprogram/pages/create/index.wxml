                      <image class="asset-thumb" src="{{item.thumb}}" style="{{item.panelPreviewStyle}}" mode="aspectFit"></image>
                    </view>
                  </scroll-view>
                </block>
              </block>
              <block wx:elif="{{polkaPaperCustomizing}}">
                <view class="polka-paper-custom-panel">
