                      <view class="polka-config-label">样式</view>
                      <view class="polka-segment-row">
                        <view wx:for="{{polkaStyles}}" wx:key="value" class="polka-segment {{selectedPolkaStyle === item.value ? 'active' : ''}}" data-style="{{item.value}}" bindtap="setPolkaPaperStyle">{{item.label}}</view>
                      </view>
                    </view>
                    <view class="polka-config-row compact">
                      <view class="polka-config-label">透明</view>
                      <view class="polka-segment-row">
                        <view wx:for="{{polkaOpacities}}" wx:key="value" class="polka-segment {{selectedPolkaOpacity === item.value ? 'active' : ''}}" data-opacity="{{item.value}}" bindtap="setPolkaPaperOpacity">{{item.label}}</view>
                      </view>
