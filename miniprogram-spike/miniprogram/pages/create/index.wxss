.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #fafaf8;
  color: #111111;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}

.empty-content,
.editor-content {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 40rpx 34rpx;
}

.empty-content {
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  padding-left: 0;
  padding-right: 0;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.empty-header {
  flex: 0 0 auto;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
}

.empty-workspace {
  width: 100%;
  box-sizing: border-box;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.empty-workspace > .starter-panel,
.empty-workspace > .material-start,
.empty-workspace > .section-head,
.empty-workspace > .draft-row,
.empty-workspace > .empty-drafts {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  align-self: stretch;
}

.page-title {
  font-size: 44rpx;
  font-weight: 650;
  line-height: 56rpx;
  white-space: nowrap;
}

.starter-panel {
  flex: 0 0 auto;
  align-self: stretch;
  display: block;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 472rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(17, 17, 17, 0.06);
  overflow: hidden;
}

.upload-zone {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 472rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e8e6e1;
  border-radius: 32rpx;
  background:
    radial-gradient(rgba(17, 17, 17, 0.028) 1rpx, transparent 1rpx) 0 0 / 22rpx 22rpx,
    linear-gradient(180deg, #ffffff, #fdfdfb);
  box-shadow: inset 0 -2rpx 0 rgba(17, 17, 17, 0.03);
  overflow: hidden;
}

.upload-zone::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 332rpx;
  height: 236rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(253, 253, 251, 0.34));
  transform: translate(-50%, -50%) rotate(-3deg);
  box-shadow: inset 0 0 0 1rpx rgba(17, 17, 17, 0.04);
}

.upload-zone::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 116rpx;
  width: 148rpx;
  height: 44rpx;
  background: linear-gradient(135deg, rgba(234, 212, 138, 0.58), rgba(234, 212, 138, 0.32));
  transform: translateX(-50%) rotate(-8deg);
  box-shadow: 0 6rpx 16rpx rgba(17, 17, 17, 0.06);
}

.upload-content {
  position: relative;
  z-index: 1;
  padding-top: 36rpx;
  text-align: center;
}

.round-action {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 90rpx;
  box-shadow: 0 20rpx 44rpx rgba(17, 17, 17, 0.16);
}

.primary-label {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 40rpx;
}

.helper {
  margin-top: 14rpx;
  color: #6f6f6f;
  font-size: 24rpx;
  line-height: 34rpx;
}

.material-start {
  align-self: stretch;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 108rpx;
  margin: 24rpx 0 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(17, 17, 17, 0.06);
  text-align: left;
}

.quick-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  color: #111111;
}

.quick-paper {
  position: absolute;
  border: 1rpx solid rgba(17, 17, 17, 0.12);
  border-radius: 6rpx;
  box-shadow: 0 8rpx 18rpx rgba(17, 17, 17, 0.08);
}

.quick-paper.back {
  left: 24rpx;
  top: 9rpx;
  width: 28rpx;
  height: 40rpx;
  background: #ffffff;
  transform: rotate(8deg);
}

.quick-paper.front {
  left: 12rpx;
  top: 17rpx;
  width: 32rpx;
  height: 39rpx;
  background: #efe7d8;
  transform: rotate(-8deg);
}

.material-copy {
  flex: 1;
  min-width: 0;
}

.material-copy view {
  font-size: 28rpx;
  font-weight: 650;
  line-height: 36rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.material-arrow {
  color: #9a9a9a;
  font-size: 44rpx;
  line-height: 1;
}

.section-head {
  align-self: stretch;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
  margin: 64rpx 0 24rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.draft-row {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
}

.draft-row > .draft-thumb {
  flex: 0 0 calc(50% - 12rpx);
  margin: 0 0 24rpx;
}

.draft-thumb {
  margin: 0;
  width: calc(50% - 12rpx);
  height: 356rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(17, 17, 17, 0.06);
}

.draft-art {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background: #fdfdfb;
  overflow: hidden;
}

.draft-preview {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background: #fdfdfb;
}

.draft-paper {
  position: absolute;
  left: 34rpx;
  top: 36rpx;
  width: 112rpx;
  height: 132rpx;
  background: #efe7d8;
  transform: rotate(2deg);
  box-shadow: 0 12rpx 32rpx rgba(17, 17, 17, 0.1);
}

.draft-tape {
  position: absolute;
  left: 44rpx;
  top: 28rpx;
  width: 96rpx;
  height: 24rpx;
  background: #e9d28a;
  transform: rotate(-8deg);
}

.draft-line {
  position: absolute;
  left: 42rpx;
  bottom: 46rpx;
  width: 104rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #111111;
}

.draft-line.short {
  bottom: 64rpx;
  width: 70rpx;
}

.empty-drafts {
  width: 100%;
  min-height: 180rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: none;
}

.empty-draft-stack {
  position: relative;
  flex: 0 0 auto;
  width: 150rpx;
  height: 136rpx;
}

.empty-draft-card {
  position: absolute;
  width: 72rpx;
  height: 92rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(17, 17, 17, 0.08);
}

.empty-draft-card.card-a {
  left: 10rpx;
  top: 30rpx;
  background: #fdfdfb;
  transform: rotate(-7deg);
}

.empty-draft-card.card-b {
  left: 42rpx;
  top: 14rpx;
  background: #efe7d8;
  transform: rotate(5deg);
}

.empty-draft-card.card-c {
  right: 8rpx;
  top: 38rpx;
  height: 74rpx;
  background: #f7f7f5;
  transform: rotate(10deg);
}

.empty-draft-tape {
  position: absolute;
  left: 46rpx;
  top: 16rpx;
  width: 78rpx;
  height: 26rpx;
  background: rgba(234, 212, 138, 0.72);
  box-shadow: 0 6rpx 16rpx rgba(17, 17, 17, 0.06);
  transform: rotate(-12deg);
}

.empty-draft-copy {
  min-width: 0;
}

.empty-draft-copy view {
  color: #111111;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 38rpx;
}

.empty-draft-copy text {
  display: block;
  margin-top: 8rpx;
  color: #6f6f6f;
  font-size: 23rpx;
  line-height: 32rpx;
}

.editor-content {
  position: relative;
  isolation: isolate;
  padding: 0 0 34rpx;
}

.editor-safe {
  position: relative;
  z-index: 20;
  box-sizing: border-box;
  background: #fafaf8;
}

.editor-topbar {
  position: relative;
  z-index: 20;
  height: 112rpx;
  display: grid;
  grid-template-columns: minmax(88rpx, 1fr) auto minmax(250rpx, 1fr);
  align-items: center;
  gap: 16rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eceae5;
  background: #fafaf8;
}

.editor-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  justify-self: end;
  min-width: 250rpx;
}

.top-control {
  box-sizing: border-box;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #111111;
  line-height: 1;
}

.line-icon {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.editor-topbar > .icon-button {
  justify-self: start;
}

.editor-topbar > .ratio-pill {
  justify-self: center;
}

.icon-button.disabled {
  opacity: 0.75;
}

.ratio-pill,
.export-btn {
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
}

.ratio-pill {
  min-width: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e8e6e1;
  background: #f7f7f5;
  color: #111111;
  font-weight: 700;
}

.export-btn {
  min-width: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #ffffff;
  font-weight: 650;
  text-align: center;
}

.export-btn.disabled {
  opacity: 0.72;
}

.ratio-popover {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 999;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(17, 17, 17, 0.1);
}

.ratio-option {
  min-width: 136rpx;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f6f6f;
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
}

.ratio-option.active {
  background: #f7f7f5;
  color: #111111;
  font-weight: 700;
}

.brush-dev-entry {
  position: fixed;
  right: 28rpx;
  top: 196rpx;
  width: 132rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.78);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 700;
  z-index: 940;
}

.effect-dev-entry {
  position: fixed;
  right: 28rpx;
  top: 260rpx;
  width: 132rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(217, 74, 56, 0.82);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 700;
  z-index: 940;
}

.brush-dev-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 332rpx;
  box-sizing: border-box;
  padding: 12rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eceae5;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -16rpx 44rpx rgba(17, 17, 17, 0.06);
  z-index: 960;
}

.image-effect-panel {
  min-height: 500rpx;
}

.brush-panel-head {
  position: relative;
  height: 68rpx;
}

.brush-panel-cancel,
.brush-panel-done {
  position: absolute;
  top: 0;
  width: 136rpx;
  height: 68rpx;
  color: #111111;
  font-size: 28rpx;
  line-height: 68rpx;
  font-weight: 650;
}

.brush-panel-cancel {
  left: 0;
  text-align: left;
}

.brush-panel-done {
  right: 0;
  text-align: right;
}

.brush-panel-done.disabled {
  opacity: 0.36;
}

.brush-panel-title {
  position: absolute;
  left: 152rpx;
  right: 152rpx;
  top: 0;
  height: 68rpx;
  color: #111111;
  font-size: 30rpx;
  line-height: 68rpx;
  text-align: center;
  font-weight: 700;
}

.brush-section {
  margin-top: 8rpx;
}

.brush-section-controls {
  position: relative;
  height: 82rpx;
  margin-top: 12rpx;
}

.brush-section-title {
  height: 34rpx;
  color: #111111;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.brush-type-grid {
  height: 56rpx;
  margin-top: 6rpx;
}

.brush-type {
  display: inline-block;
  width: 104rpx;
  height: 52rpx;
  margin: 0 10rpx 6rpx 0;
  border-radius: 18rpx;
  background: #f7f7f5;
  color: #4f4f4a;
  font-size: 23rpx;
  line-height: 52rpx;
  text-align: center;
  vertical-align: top;
}

.brush-type:nth-child(6n) {
  margin-right: 0;
}

.brush-type.active {
  background: #111111;
  color: #ffffff;
  font-weight: 700;
}

.brush-color-row {
  position: absolute;
  left: 0;
  top: 38rpx;
  height: 50rpx;
  white-space: nowrap;
}

.brush-size-title {
  position: absolute;
  left: 438rpx;
  top: 0;
}

.brush-size-row {
  position: absolute;
  left: 438rpx;
  right: 0;
  top: 38rpx;
  height: 50rpx;
  white-space: nowrap;
}

.brush-color {
  display: inline-block;
  width: 44rpx;
  height: 44rpx;
  margin: 3rpx 14rpx 0 0;
  border: 3rpx solid rgba(17, 17, 17, 0.14);
  border-radius: 50%;
  box-sizing: border-box;
  vertical-align: top;
}

.brush-color.active {
  border-color: #111111;
  box-shadow: 0 0 0 5rpx rgba(17, 17, 17, 0.1);
}

.brush-size {
  display: inline-block;
  width: 64rpx;
  height: 44rpx;
  margin: 3rpx 8rpx 0 0;
  border-radius: 999rpx;
  background: #f5f2eb;
  color: #111111;
  font-size: 22rpx;
  line-height: 44rpx;
  text-align: center;
  vertical-align: top;
}

.brush-size.active {
  background: #111111;
  color: #ffffff;
  font-weight: 700;
}

.brush-panel-actions {
  height: 58rpx;
  margin-top: 28rpx;
  white-space: nowrap;
  text-align: center;
}

.brush-panel-action {
  display: inline-block;
  width: 210rpx;
  height: 54rpx;
  margin: 0 10rpx;
  border-radius: 999rpx;
  background: #f5f2eb;
  color: #111111;
  font-size: 24rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 650;
}

.brush-panel-action.danger {
  color: #d94a38;
}

.brush-panel-action.disabled {
  opacity: 0.42;
}

.canvas-stage {
  position: relative;
  top: 0;
  z-index: 0;
  height: calc(100vh - 300rpx);
  min-height: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 16rpx 0 208rpx;
  overflow: hidden;
  transition: top 160ms ease, transform 160ms ease;
}

.canvas-stage.panel-active {
  z-index: 0;
}

.canvas-stage.layer-editing {
  padding-bottom: calc(252rpx + env(safe-area-inset-bottom));
}

.canvas-stage.text-editing {
  top: 0;
  transition: none;
}

.canvas-stage.brush-editing {
  min-height: 0;
  padding: 6rpx 0 8rpx;
  align-items: flex-end;
}

.canvas-stage.effect-editing {
  min-height: 0;
  padding: 6rpx 0 8rpx;
  align-items: flex-end;
}

.canvas {
  display: block;
  position: relative;
  z-index: 0;
  background: #fdfdfb;
  box-shadow: 0 18rpx 58rpx rgba(17, 17, 17, 0.12);
}

.canvas-shell {
  position: relative;
}

.selected-layer-lock {
  position: absolute;
  width: 28px;
  height: 28px;
  margin-left: -14px;
  margin-top: -14px;
  z-index: 6;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.54);
  box-shadow: 0 4rpx 12rpx rgba(17, 17, 17, 0.10);
}

.selected-layer-lock.locked {
  background: rgba(255, 255, 255, 0.62);
  box-shadow: 0 0 0 1rpx rgba(17, 17, 17, 0.10), 0 4rpx 12rpx rgba(17, 17, 17, 0.10);
}

.selected-layer-lock-icon {
  display: block;
  width: 18px;
  height: 18px;
  margin: 5px 0 0 5px;
}

.straight-cut-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 4;
}

.straight-cut-actions {
  position: fixed;
  left: 50%;
  bottom: calc(198rpx + env(safe-area-inset-bottom));
  width: 280rpx;
  height: 72rpx;
  margin-left: -140rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 44rpx rgba(17, 17, 17, 0.12);
  z-index: 935;
  display: flex;
  align-items: center;
  justify-content: center;
}

.straight-cut-button {
  flex: 1;
  height: 72rpx;
  color: #111111;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.straight-cut-button.secondary {
  color: #77736d;
  font-weight: 500;
}

.main-toolbar,
.layer-toolbar,
.effect-editor-panel,
.tool-palette,
.drawer-backdrop,
.drawer,
.text-editor-panel {
  position: fixed;
  z-index: 900;
}

/* Panel typography rules:
 * - Panel top inset: 12rpx. Title row: 68rpx.
 * - Panel title-to-content gap: 10rpx.
 * - Panel titles: 32rpx / 68rpx, weight 700, black.
 * - Top-left/right text actions: 28rpx / 68rpx, no background.
 * - Primary tool labels: 24rpx / 32rpx.
 * - Layer action labels: 26rpx / 34rpx.
 */

.main-toolbar {
  left: 24rpx;
  right: 24rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  height: 126rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 16rpx 56rpx rgba(17, 17, 17, 0.1);
  overflow: hidden;
}

.tool {
  position: absolute;
  top: 10rpx;
  width: 14.2857%;
  height: 106rpx;
  color: #6f6f6f;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.tool-0 { left: 0; }
.tool-1 { left: 14.2857%; }
.tool-2 { left: 28.5714%; }
.tool-3 { left: 42.8571%; }
.tool-4 { left: 57.1428%; }
.tool-5 { left: 71.4285%; }
.tool-6 { left: 85.7142%; }

.tool-label {
  position: absolute;
  left: 0;
  right: 0;
  top: 76rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
}

.tool-icon {
  position: absolute;
  left: 50%;
  top: -2rpx;
  width: 82rpx;
  height: 82rpx;
  margin-left: -41rpx;
  opacity: 0.72;
}

.brush-tool-icon {
  top: 12rpx;
  width: 56rpx;
  height: 56rpx;
  margin-left: -28rpx;
}

.tool.active {
  color: #111111;
  font-weight: 650;
}

.tool.active .tool-icon {
  opacity: 1;
  transform: scale(1.08);
}

.tool-palette {
  left: 140rpx;
  right: 140rpx;
  bottom: calc(196rpx + env(safe-area-inset-bottom));
  height: 144rpx;
  border: 1rpx solid rgba(232, 230, 225, 0.62);
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 16rpx 48rpx rgba(17, 17, 17, 0.08);
