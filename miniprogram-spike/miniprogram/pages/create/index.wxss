.effect-adjust-trigger {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  background: transparent;
  box-sizing: border-box;
}

.effect-option > view.effect-adjust-trigger {
  height: 52rpx;
  line-height: normal;
}

.effect-adjust-trigger::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 2rpx solid #111111;
  background: #ffffff;
}

.effect-adjust-trigger > view {
  position: absolute;
  width: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #111111;
  z-index: 1;
}

.effect-adjust-trigger > view:nth-child(1) { transform: translate(8rpx, -16rpx); }
.effect-adjust-trigger > view:nth-child(2) { transform: translate(8rpx, -8rpx); }
.effect-adjust-trigger > view:nth-child(3) { transform: translate(8rpx, 0); }

.effect-adjust-trigger > view::after {
  content: "";
  position: absolute;
  top: -4rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #111111;
}

.effect-adjust-trigger > view:nth-child(1)::after,
.effect-adjust-trigger > view:nth-child(3)::after { left: 2rpx; }
.effect-adjust-trigger > view:nth-child(2)::after { right: 2rpx; }

