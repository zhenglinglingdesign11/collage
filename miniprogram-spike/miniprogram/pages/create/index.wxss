.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #fafaf8;
  color: #111111;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}

.empty-content,
.editor-content {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 40rpx 34rpx;
}

.empty-content {
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  padding-left: 0;
  padding-right: 0;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.empty-header {
  flex: 0 0 auto;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
}

.empty-workspace {
  width: 100%;
  box-sizing: border-box;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.empty-workspace > .starter-panel,
.empty-workspace > .material-start,
.empty-workspace > .section-head,
.empty-workspace > .draft-row,
.empty-workspace > .empty-drafts {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  align-self: stretch;
}

.page-title {
  font-size: 44rpx;
  font-weight: 650;
  line-height: 56rpx;
  white-space: nowrap;
}

.starter-panel {
  flex: 0 0 auto;
  align-self: stretch;
  display: block;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 472rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(17, 17, 17, 0.06);
  overflow: hidden;
}

.upload-zone {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 472rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e8e6e1;
  border-radius: 32rpx;
  background:
    radial-gradient(rgba(17, 17, 17, 0.028) 1rpx, transparent 1rpx) 0 0 / 22rpx 22rpx,
    linear-gradient(180deg, #ffffff, #fdfdfb);
  box-shadow: inset 0 -2rpx 0 rgba(17, 17, 17, 0.03);
  overflow: hidden;
}

.upload-zone::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 332rpx;
  height: 236rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(253, 253, 251, 0.34));
  transform: translate(-50%, -50%) rotate(-3deg);
  box-shadow: inset 0 0 0 1rpx rgba(17, 17, 17, 0.04);
}

.upload-zone::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 116rpx;
  width: 148rpx;
  height: 44rpx;
  background: linear-gradient(135deg, rgba(234, 212, 138, 0.58), rgba(234, 212, 138, 0.32));
  transform: translateX(-50%) rotate(-8deg);
  box-shadow: 0 6rpx 16rpx rgba(17, 17, 17, 0.06);
}

.upload-content {
  position: relative;
  z-index: 1;
  padding-top: 36rpx;
  text-align: center;
}

.round-action {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #111111;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 90rpx;
  box-shadow: 0 20rpx 44rpx rgba(17, 17, 17, 0.16);
}

.primary-label {
  font-size: 30rpx;
  font-weight: 650;
  line-height: 40rpx;
}

.helper {
  margin-top: 14rpx;
  color: #6f6f6f;
  font-size: 24rpx;
  line-height: 34rpx;
}

.material-start {
  align-self: stretch;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 108rpx;
  margin: 24rpx 0 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(17, 17, 17, 0.06);
  text-align: left;
}

.quick-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  color: #111111;
}

.quick-paper {
  position: absolute;
  border: 1rpx solid rgba(17, 17, 17, 0.12);
  border-radius: 6rpx;
  box-shadow: 0 8rpx 18rpx rgba(17, 17, 17, 0.08);
}

.quick-paper.back {
  left: 24rpx;
  top: 9rpx;
  width: 28rpx;
  height: 40rpx;
  background: #ffffff;
  transform: rotate(8deg);
}

.quick-paper.front {
  left: 12rpx;
  top: 17rpx;
  width: 32rpx;
  height: 39rpx;
  background: #efe7d8;
  transform: rotate(-8deg);
}

.material-copy {
  flex: 1;
  min-width: 0;
}

.material-copy view {
  font-size: 28rpx;
  font-weight: 650;
  line-height: 36rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.material-arrow {
  color: #9a9a9a;
  font-size: 44rpx;
  line-height: 1;
}

.section-head {
  align-self: stretch;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
  margin: 64rpx 0 24rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.draft-row {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
}

.draft-row > .draft-thumb {
  flex: 0 0 calc(50% - 12rpx);
  margin: 0 0 24rpx;
}

.draft-thumb {
  margin: 0;
  width: calc(50% - 12rpx);
  height: 356rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(17, 17, 17, 0.06);
}

.draft-art {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background: #fdfdfb;
  overflow: hidden;
}

.draft-preview {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background: #fdfdfb;
}

.draft-paper {
  position: absolute;
  left: 34rpx;
  top: 36rpx;
  width: 112rpx;
  height: 132rpx;
  background: #efe7d8;
  transform: rotate(2deg);
  box-shadow: 0 12rpx 32rpx rgba(17, 17, 17, 0.1);
}

.draft-tape {
  position: absolute;
  left: 44rpx;
  top: 28rpx;
  width: 96rpx;
  height: 24rpx;
  background: #e9d28a;
  transform: rotate(-8deg);
}

.draft-line {
  position: absolute;
  left: 42rpx;
  bottom: 46rpx;
  width: 104rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #111111;
}

.draft-line.short {
  bottom: 64rpx;
  width: 70rpx;
}

.empty-drafts {
  width: 100%;
  min-height: 180rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: none;
}

.empty-draft-stack {
  position: relative;
  flex: 0 0 auto;
  width: 150rpx;
  height: 136rpx;
}

.empty-draft-card {
  position: absolute;
  width: 72rpx;
  height: 92rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(17, 17, 17, 0.08);
}

.empty-draft-card.card-a {
  left: 10rpx;
  top: 30rpx;
  background: #fdfdfb;
  transform: rotate(-7deg);
}

.empty-draft-card.card-b {
  left: 42rpx;
  top: 14rpx;
  background: #efe7d8;
  transform: rotate(5deg);
}

.empty-draft-card.card-c {
  right: 8rpx;
  top: 38rpx;
  height: 74rpx;
  background: #f7f7f5;
  transform: rotate(10deg);
}

.empty-draft-tape {
  position: absolute;
  left: 46rpx;
  top: 16rpx;
  width: 78rpx;
  height: 26rpx;
  background: rgba(234, 212, 138, 0.72);
  box-shadow: 0 6rpx 16rpx rgba(17, 17, 17, 0.06);
  transform: rotate(-12deg);
}

.empty-draft-copy {
  min-width: 0;
}

.empty-draft-copy view {
  color: #111111;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 38rpx;
}

.empty-draft-copy text {
  display: block;
  margin-top: 8rpx;
  color: #6f6f6f;
  font-size: 23rpx;
  line-height: 32rpx;
}

.editor-content {
  position: relative;
  isolation: isolate;
  padding: 0 0 34rpx;
}

.editor-safe {
  box-sizing: border-box;
}

.editor-topbar {
  height: 112rpx;
  display: grid;
  grid-template-columns: minmax(88rpx, 1fr) auto minmax(250rpx, 1fr);
  align-items: center;
  gap: 16rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eceae5;
  background: #fafaf8;
}

.editor-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  justify-self: end;
  min-width: 250rpx;
}

.top-control {
  box-sizing: border-box;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #111111;
  line-height: 1;
}

.line-icon {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.editor-topbar > .icon-button {
  justify-self: start;
}

.editor-topbar > .ratio-pill {
  justify-self: center;
}

.icon-button.disabled {
  opacity: 0.75;
}

.ratio-pill,
.export-btn {
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
}

.ratio-pill {
  min-width: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e8e6e1;
  background: #f7f7f5;
  color: #111111;
  font-weight: 700;
}

.export-btn {
  min-width: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #ffffff;
  font-weight: 650;
  text-align: center;
}

.export-btn.disabled {
  opacity: 0.72;
}

.ratio-popover {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 999;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(17, 17, 17, 0.1);
}

.ratio-option {
  min-width: 136rpx;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f6f6f;
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
}

.ratio-option.active {
  background: #f7f7f5;
  color: #111111;
  font-weight: 700;
}

.canvas-stage {
  position: relative;
  top: 0;
  z-index: 1;
  height: calc(100vh - 300rpx);
  min-height: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 16rpx 0 208rpx;
  overflow: hidden;
  transition: top 160ms ease;
}

.canvas-stage.panel-active {
  z-index: 0;
}

.canvas-stage.text-editing {
  top: -96rpx;
}

.canvas {
  display: block;
  position: relative;
  z-index: 0;
  background: #fdfdfb;
  box-shadow: 0 18rpx 58rpx rgba(17, 17, 17, 0.12);
}

.canvas-shell {
  position: relative;
}

.straight-cut-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 4;
}

.straight-cut-actions {
  position: fixed;
  left: 50%;
  bottom: calc(198rpx + env(safe-area-inset-bottom));
  width: 280rpx;
  height: 72rpx;
  margin-left: -140rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 44rpx rgba(17, 17, 17, 0.12);
  z-index: 935;
  display: flex;
  align-items: center;
  justify-content: center;
}

.straight-cut-button {
  flex: 1;
  height: 72rpx;
  color: #111111;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.straight-cut-button.secondary {
  color: #77736d;
  font-weight: 500;
}

.main-toolbar,
.layer-toolbar,
.tool-palette,
.drawer-backdrop,
.drawer,
.text-editor-panel {
  position: fixed;
  z-index: 900;
}

/* Panel typography rules:
 * - Panel top inset: 12rpx. Title row: 68rpx.
 * - Panel title-to-content gap: 10rpx.
 * - Panel titles: 32rpx / 68rpx, weight 700, black.
 * - Top-left/right text actions: 28rpx / 68rpx, no background.
 * - Primary tool labels: 24rpx / 32rpx.
 * - Layer action labels: 26rpx / 34rpx.
 */

.main-toolbar {
  left: 24rpx;
  right: 24rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  height: 126rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 16rpx 56rpx rgba(17, 17, 17, 0.1);
  overflow: hidden;
}

.tool {
  position: absolute;
  top: 10rpx;
  width: 16.6666%;
  height: 106rpx;
  color: #6f6f6f;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.tool-0 { left: 0; }
.tool-1 { left: 16.6666%; }
.tool-2 { left: 33.3333%; }
.tool-3 { left: 50%; }
.tool-4 { left: 66.6666%; }
.tool-5 { left: 83.3333%; }

.tool-label {
  position: absolute;
  left: 0;
  right: 0;
  top: 76rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
}

.tool-icon {
  position: absolute;
  left: 50%;
  top: -2rpx;
  width: 82rpx;
  height: 82rpx;
  margin-left: -41rpx;
  opacity: 0.72;
}

.tool.active {
  color: #111111;
  font-weight: 650;
}

.tool.active .tool-icon {
  opacity: 1;
  transform: scale(1.08);
}

.tool-palette {
  left: 140rpx;
  right: 140rpx;
  bottom: calc(196rpx + env(safe-area-inset-bottom));
  height: 144rpx;
  border: 1rpx solid rgba(232, 230, 225, 0.62);
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 16rpx 48rpx rgba(17, 17, 17, 0.08);
  z-index: 930;
}

.shape-palette {
  left: 54rpx;
  right: 54rpx;
}

.outline-palette {
  left: 26rpx;
  right: 26rpx;
}

.layer-cut-palette {
  bottom: calc(246rpx + env(safe-area-inset-bottom));
}

.layer-shape-palette {
  bottom: calc(246rpx + env(safe-area-inset-bottom));
}

.layer-outline-palette {
  bottom: calc(246rpx + env(safe-area-inset-bottom));
}

.palette-tool {
  position: absolute;
  bottom: 0;
  height: 132rpx;
  border-radius: 32rpx;
  color: #6f6f6f;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.cut-palette .palette-tool {
  width: 25%;
}

.shape-palette .palette-tool {
  width: 20%;
}

.outline-palette .palette-tool {
  width: 16.666%;
}

.palette-tool-0 { left: 0; }
.cut-palette .palette-tool-1 { left: 25%; }
.cut-palette .palette-tool-2 { left: 50%; }
.cut-palette .palette-tool-3 { left: 75%; }
.shape-palette .palette-tool-1 { left: 20%; }
.shape-palette .palette-tool-2 { left: 40%; }
.shape-palette .palette-tool-3 { left: 60%; }
.shape-palette .palette-tool-4 { left: 80%; }
.outline-palette .palette-tool-1 { left: 16.666%; }
.outline-palette .palette-tool-2 { left: 33.333%; }
.outline-palette .palette-tool-3 { left: 50%; }
.outline-palette .palette-tool-4 { left: 66.666%; }
.outline-palette .palette-tool-5 { left: 83.333%; }

.palette-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
}

.outline-palette .palette-label {
  left: 8rpx;
  right: 8rpx;
  bottom: 18rpx;
  height: 36rpx;
  border-radius: 999rpx;
  color: #5f5f5a;
  font-size: 22rpx;
  line-height: 36rpx;
  font-weight: 500;
}

.outline-palette .palette-tool.active .palette-label {
  background: #111111;
  color: #ffffff;
  font-weight: 700;
}

.cut-palette .palette-label {
  bottom: 18rpx;
  color: #111111;
  font-weight: 650;
}

.palette-tool.active {
  color: #111111;
  font-weight: 650;
}

.cut-icon {
  position: absolute;
  left: 50%;
  bottom: 50rpx;
  width: 76rpx;
  height: 76rpx;
  margin-left: -38rpx;
  object-fit: contain;
  transform-origin: bottom center;
  filter: drop-shadow(0 8rpx 12rpx rgba(17, 17, 17, 0.12));
}

.palette-tool.active .cut-icon {
  bottom: 48rpx;
  width: 86rpx;
  height: 86rpx;
  margin-left: -43rpx;
}

.cut-3d,
.emboss-3d {
  position: absolute;
  left: 50%;
  bottom: 32rpx;
  width: 76rpx;
  height: 104rpx;
  margin-left: -38rpx;
  border-radius: 30rpx 30rpx 16rpx 16rpx;
  background: #efe7d8;
  box-shadow: 0 8rpx 18rpx rgba(17, 17, 17, 0.1);
  transform-origin: bottom center;
}

.palette-tool.active .cut-3d,
.palette-tool.active .emboss-3d {
  width: 94rpx;
  height: 128rpx;
  margin-left: -47rpx;
}

.outline-swatch {
  position: absolute;
  left: 50%;
  bottom: 66rpx;
  width: 58rpx;
  height: 42rpx;
  margin-left: -29rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #efe7d8;
  box-shadow: 0 8rpx 18rpx rgba(17, 17, 17, 0.1);
}

.outline-swatch-white {
  border: 9rpx solid #ffffff;
}

.outline-swatch-cream {
  border: 8rpx solid #f4ead8;
}

.outline-swatch-dark {
  border: 7rpx solid #111111;
}

.outline-swatch-red {
  border: 7rpx solid #d94a38;
}

.outline-swatch-double {
  border: 9rpx solid #ffffff;
  box-shadow:
    inset 0 0 0 4rpx rgba(17, 17, 17, 0.72),
    0 8rpx 18rpx rgba(17, 17, 17, 0.1);
}

.outline-swatch-none {
  border: 2rpx dashed rgba(17, 17, 17, 0.34);
  background: rgba(239, 231, 216, 0.5);
}

.palette-tool.active .outline-swatch {
  bottom: 62rpx;
  width: 70rpx;
  height: 52rpx;
  margin-left: -35rpx;
}

.cut-3d.straight {
  clip-path: polygon(0 14%, 100% 0, 100% 100%, 0 100%);
}

.cut-3d.scallop {
  border-radius: 40rpx 40rpx 18rpx 18rpx;
  background: #ead48a;
}

.cut-3d.tear {
  clip-path: polygon(0 0, 100% 12%, 92% 100%, 8% 88%);
  background: #f1d4c8;
}

.cut-3d.subject {
  border-radius: 50% 50% 42% 42%;
  background: #d7dbc9;
}

.emboss-3d.circle {
  border-radius: 50%;
  background: #f5dfd8;
}

.emboss-3d.rect {
  border-radius: 16rpx;
  background: #f4efe5;
}

.emboss-3d.heart {
  width: 76rpx;
  height: 76rpx;
  bottom: 44rpx;
  margin-left: -38rpx;
  background: #f1d4c8;
  transform: none;
  clip-path: polygon(50% 90%, 44% 84%, 36% 78%, 27% 71%, 19% 63%, 12% 53%, 8% 43%, 7% 34%, 10% 25%, 16% 18%, 25% 14%, 34% 14%, 42% 18%, 48% 27%, 50% 34%, 52% 27%, 58% 18%, 66% 14%, 75% 14%, 84% 18%, 90% 25%, 93% 34%, 92% 43%, 88% 53%, 81% 63%, 73% 71%, 64% 78%, 56% 84%);
}

.emboss-3d.tag {
  border-radius: 24rpx 24rpx 12rpx 12rpx;
  background: #efe7d8;
  transform: rotate(-5deg);
}

.emboss-3d.star {
  clip-path: polygon(50% 0, 61% 34%, 98% 35%, 68% 56%, 79% 91%, 50% 70%, 21% 91%, 32% 56%, 2% 35%, 39% 34%);
  background: #ead48a;
}

.emboss-3d.stamp {
