.page {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  background: #fafaf8;
  color: #111111;
  overflow: hidden;
}

.detail-mode {
  position: fixed;
  inset: 0;
  overflow: hidden;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}

.sheet-page {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

.sheet-header {
  width: auto;
  box-sizing: border-box;
  margin: 0 40rpx;
}

.sheet-inner {
  width: auto;
  min-height: 100%;
  box-sizing: border-box;
  margin: 0 40rpx;
  padding: 0 0 calc(172rpx + env(safe-area-inset-bottom));
}

.list-page-title {
  padding-top: 36rpx;
  font-size: 44rpx;
  font-weight: 650;
  line-height: 56rpx;
}

.category-tabs {
  width: 100%;
  height: 64rpx;
  margin: 18rpx 0 32rpx;
  white-space: nowrap;
  color: #6f6f6f;
  font-size: 30rpx;
}

.category-track {
  display: inline-flex;
  min-width: 100%;
  align-items: flex-start;
  white-space: nowrap;
}

.category-tab {
  position: relative;
  flex: 0 0 auto;
  height: 64rpx;
  margin-right: 36rpx;
  padding: 0 0 12rpx;
  color: inherit;
  font-size: 30rpx;
  line-height: 54rpx;
  white-space: nowrap;
}

.category-tab.active {
  color: #111111;
  font-weight: 650;
}

.category-tab.active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2rpx;
  background: #111111;
}

.pack-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  box-sizing: border-box;
  width: 100%;
}

.pack-card {
  position: relative;
  display: block;
  flex: 0 0 319rpx;
  width: 319rpx;
  min-width: 0;
  height: 344rpx;
  box-sizing: border-box;
  margin: 0 32rpx 32rpx 0;
  margin-left: 0;
  align-self: flex-start;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(17, 17, 17, 0.08);
  overflow: hidden;
  text-align: left;
  transform: translateZ(0);
}

.pack-card:nth-child(2n) {
  margin-right: 0;
}

.pack-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.pack-favorite-mark {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  z-index: 2;
  width: 44rpx;
  height: 44rpx;
  color: #111111;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
}

.empty-note {
  margin-top: 80rpx;
  color: #9a9a9a;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.editor-topbar {
  height: 112rpx;
  display: grid;
  grid-template-columns: minmax(88rpx, 1fr) auto minmax(250rpx, 1fr);
  align-items: center;
  gap: 16rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eceae5;
  background: #fafaf8;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #111111;
  line-height: 1;
}

.top-control {
  box-sizing: border-box;
}

.editor-topbar > .back-button {
  justify-self: start;
}

.editor-topbar > .favorite-button {
  justify-self: end;
  font-size: 36rpx;
  line-height: 72rpx;
}

.line-icon {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.detail-title {
  justify-self: center;
  max-width: 360rpx;
  min-width: 0;
  color: #111111;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 40rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-paper-shell {
  box-sizing: border-box;
  padding: 24rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.detail-paper {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e8e6e1;
  border-radius: 20rpx;
  background:
    radial-gradient(rgba(17, 17, 17, 0.03) 1rpx, transparent 1rpx) 0 0 / 20rpx 20rpx,
    #ffffff;
  overflow: hidden;
  touch-action: none;
}

.floating-piece {
  position: absolute;
  box-shadow: 0 20rpx 52rpx rgba(17, 17, 17, 0.11);
}

.detail-asset {
  display: block;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.detail-asset.selected {
  outline: 2rpx solid #111111;
  outline-offset: 0;
}

.detail-thumb {
  width: 100%;
  height: 100%;
  background: transparent;
  display: block;
}

.selected-asset-tray {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 144rpx;
  height: 88rpx;
  box-sizing: border-box;
  padding: 8rpx 0;
  white-space: nowrap;
}

.selected-asset-chip {
  display: inline-flex;
  align-items: center;
  height: 72rpx;
  max-width: 132rpx;
  margin-right: 16rpx;
  padding: 0 8rpx 0 10rpx;
  border: 1rpx solid #e8e6e1;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.selected-asset-preview {
  width: 48rpx;
  height: 48rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: transparent;
}

.selected-asset-preview image {
  width: 48rpx;
  height: 48rpx;
  background: transparent;
  display: block;
}

.selected-asset-chip button {
  width: 44rpx;
  height: 44rpx;
  margin-left: 6rpx;
  color: #111111;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
}

.add-to-canvas {
  position: absolute;
  left: 50%;
  bottom: 48rpx;
  transform: translateX(-50%);
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 72rpx;
  box-shadow: 0 16rpx 56rpx rgba(17, 17, 17, 0.1);
}

.add-to-canvas.disabled {
  background: #f7f7f5;
  color: #9a9a9a;
  box-shadow: none;
}
