<view class="page {{detailPack ? 'detail-mode' : ''}}">
  <block wx:if="{{!detailPack}}">
    <view class="list-safe" style="height: {{navBarHeight}}px;"></view>
    <view class="sheet-header">
      <view class="sheet-title-row">
        <view class="list-page-title">素材包</view>
        <view wx:if="{{assetSelectionMode}}" class="return-create-button" bindtap="returnToCreateFromAssets">返回创作</view>
      </view>
      <scroll-view scroll-x class="category-tabs" show-scrollbar="{{false}}" enhanced="{{true}}">
        <view class="category-track">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="category-tab {{activeCategory === item ? 'active' : ''}}"
            data-category="{{item}}"
            bindtap="setAssetCategory"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
    <scroll-view scroll-y class="sheet-page" style="height: calc(100vh - {{navBarHeight}}px - 206rpx);">
      <view class="sheet-inner">
        <view wx:if="{{visiblePacks.length}}" class="pack-grid">
          <view
            wx:for="{{visiblePacks}}"
            wx:key="id"
            class="pack-card pack-card-{{index}}"
            data-pack="{{item.id}}"
            bindtap="openPack"
            aria-label="{{item.name}}"
          >
            <view wx:if="{{item.isFavorite}}" class="pack-favorite-mark">★</view>
            <view wx:if="{{item.coverPreviews.length}}" class="pack-cover pack-preview-cover {{item.isBasicShapePack ? 'basic-shape-pack-cover' : ''}}">
              <view
                wx:for="{{item.coverPreviews}}"
                wx:for-item="preview"
                wx:for-index="previewIndex"
                wx:key="previewIndex"
                class="pack-preview-item {{item.isBasicShapePack ? 'basic-shape-preview-item' : ''}}"
                style="{{preview.previewStyle}}"
              >
                <image
                  wx:for="{{preview.previewTiles}}"
                  wx:for-item="tile"
                  wx:key="style"
                  class="detail-pattern-tile"
                  src="{{tile.src}}"
                  style="{{tile.style}}"
                  mode="aspectFit"
                ></image>
              </view>
            </view>
            <image wx:elif="{{item.cover}}" class="pack-cover" src="{{item.cover}}" mode="aspectFit"></image>
            <view wx:else class="pack-cover pack-cover-css" style="{{item.coverStyle}}"></view>
          </view>
        </view>
        <view wx:else class="empty-note">还没有收藏的素材包</view>
      </view>
    </scroll-view>
  </block>

  <block wx:else>
    <view class="detail-safe" style="height: {{statusTop}}px;"></view>
    <view class="editor-topbar" style="margin-top: {{toolbarGap}}px;">
      <view class="top-control icon-button back-button" bindtap="closeDetail" aria-label="返回">
        <image class="line-icon" src="/assets/icons/line-back.svg" mode="aspectFit"></image>
      </view>
      <view class="detail-title">{{detailPack.name}}</view>
      <view class="top-control icon-button favorite-button" bindtap="toggleFavoritePack" aria-label="{{detailPack.isFavorite ? '取消收藏' : '收藏'}}">
        <text>{{detailPack.isFavorite ? '★' : '☆'}}</text>
      </view>
    </view>

    <scroll-view
      scroll-y
      class="detail-paper-shell"
      style="height: calc(100vh - {{statusTop}}px - {{toolbarGap}}px - 112rpx);"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
    >
      <view class="detail-paper" style="height: {{detailPack.detailPaperHeight || detailPaperMinHeight}}rpx;">
        <view
          wx:for="{{detailPack.items}}"
          wx:key="id"
          class="detail-asset floating-piece {{item.layoutClass}} {{item.assetClass}} {{item.selected ? 'selected' : ''}} {{item.packId === 'basic-shape-materials' || item.packId === 'material-basic-shape-materials' ? 'basic-shape-detail-item' : ''}} {{item.isCustomPolkaEntry || item.isCustomSolidEntry || item.isCustomBasicShapeEntry ? 'custom-polka-entry' : ''}}"
          style="{{item.detailStyle}}"
          data-asset-id="{{item.id}}"
          bindtap="selectDetailAsset"
          aria-label="选择{{item.name}}"
        >
          <block wx:if="{{item.isCustomPolkaEntry || item.isCustomSolidEntry || item.isCustomBasicShapeEntry}}">
            <view class="custom-polka-content">
              <view class="custom-polka-plus">+</view>
              <view class="custom-polka-label">自定义</view>
            </view>
          </block>
          <block wx:elif="{{item.thumb}}">
            <image class="detail-thumb" src="{{item.thumb}}" mode="aspectFit"></image>
          </block>
          <view wx:else class="detail-thumb detail-thumb-css {{item.packId === 'basic-shape-materials' || item.packId === 'material-basic-shape-materials' ? 'basic-shape-detail-thumb' : ''}}" style="{{item.previewStyle}}">
            <image
              wx:for="{{item.previewTiles}}"
              wx:for-item="tile"
              wx:key="style"
              class="detail-pattern-tile"
              src="{{tile.src}}"
              style="{{tile.style}}"
              mode="aspectFit"
            ></image>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="detail-action-bar">
      <scroll-view wx:if="{{selectedAssets.length}}" scroll-x class="selected-asset-tray" show-scrollbar="{{false}}">
        <view
          wx:for="{{selectedAssets}}"
          wx:key="id"
          class="selected-asset-chip"
        >
          <view class="selected-asset-preview">
            <image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFit"></image>
            <view wx:else class="selected-asset-css" style="{{item.previewStyle}}"></view>
          </view>
          <button data-asset-id="{{item.id}}" catchtap="removeDetailAsset" aria-label="移除{{item.name}}">×</button>
        </view>
      </scroll-view>
      <button
        class="add-to-canvas {{selectedAssetIds.length ? '' : 'disabled'}}"
        disabled="{{!selectedAssetIds.length}}"
        bindtap="addSelectedAsset"
      >添加到画布</button>
    </view>
  </block>
</view>
