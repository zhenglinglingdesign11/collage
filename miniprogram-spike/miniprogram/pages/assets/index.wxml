<view class="page {{detailPack ? 'detail-mode' : ''}}">
  <block wx:if="{{!detailPack}}">
    <view class="list-safe" style="height: {{navBarHeight}}px;"></view>
    <view class="sheet-header">
      <view class="list-page-title">素材包</view>
      <scroll-view scroll-x class="category-tabs" show-scrollbar="{{false}}" enhanced="{{true}}">
        <view class="category-track">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="category-tab {{activeCategory === item ? 'active' : ''}}"
            data-category="{{item}}"
            bindtap="setAssetCategory"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
    <scroll-view scroll-y class="sheet-page" style="height: calc(100vh - {{navBarHeight}}px - 206rpx);">
      <view class="sheet-inner">
        <view wx:if="{{visiblePacks.length}}" class="pack-grid">
          <view
            wx:for="{{visiblePacks}}"
            wx:key="id"
            class="pack-card pack-card-{{index}}"
            style="background: {{item.tone}};"
            data-pack="{{item.id}}"
            bindtap="openPack"
            aria-label="{{item.name}}"
          >
            <view wx:if="{{item.isFavorite}}" class="pack-favorite-mark">★</view>
            <image class="pack-cover" src="{{item.cover}}" mode="aspectFit"></image>
          </view>
        </view>
        <view wx:else class="empty-note">还没有收藏的素材包</view>
      </view>
    </scroll-view>
  </block>

  <block wx:else>
    <view class="detail-safe" style="height: {{statusTop}}px;"></view>
    <view class="editor-topbar" style="margin-top: {{toolbarGap}}px;">
      <view class="top-control icon-button back-button" bindtap="closeDetail" aria-label="返回">
        <image class="line-icon" src="/assets/icons/line-back.svg" mode="aspectFit"></image>
      </view>
      <view class="detail-title">{{detailPack.name}}</view>
      <view class="top-control icon-button favorite-button" bindtap="toggleFavoritePack" aria-label="{{detailPack.isFavorite ? '取消收藏' : '收藏'}}">
        <text>{{detailPack.isFavorite ? '★' : '☆'}}</text>
      </view>
    </view>

    <view class="detail-paper-shell" style="height: calc(100vh - {{statusTop}}px - {{toolbarGap}}px - 112rpx);">
      <view class="detail-paper">
        <button
          wx:for="{{detailPack.items}}"
          wx:key="id"
          class="detail-asset floating-piece {{item.layoutClass}} {{item.assetClass}} {{item.selected ? 'selected' : ''}}"
          style="{{item.detailStyle}}"
          data-asset-id="{{item.id}}"
          bindtap="selectDetailAsset"
          aria-label="选择{{item.name}}"
        >
          <image class="detail-thumb" src="{{item.thumb}}" mode="aspectFit"></image>
        </button>

        <scroll-view wx:if="{{selectedAssets.length}}" scroll-x class="selected-asset-tray" show-scrollbar="{{false}}">
          <view
            wx:for="{{selectedAssets}}"
            wx:key="id"
            class="selected-asset-chip"
          >
            <view class="selected-asset-preview">
              <image src="{{item.thumb}}" mode="aspectFit"></image>
            </view>
            <button data-asset-id="{{item.id}}" bindtap="removeDetailAsset" aria-label="移除{{item.name}}">×</button>
          </view>
        </scroll-view>
        <button
          class="add-to-canvas {{selectedAssetIds.length ? '' : 'disabled'}}"
          disabled="{{!selectedAssetIds.length}}"
          bindtap="addSelectedAsset"
        >添加到画布</button>
      </view>
    </view>
  </block>
</view>
